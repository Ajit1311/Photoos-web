"use client";

import {
  useEffect,
  useState,
} from "react";

import {
  Check,
  CheckCircle2,
  ChevronDown,
  ChevronLeft,
  ChevronUp,
  CreditCard,
  Landmark,
  Smartphone,
} from "lucide-react";

import {
  useRouter,
  useSearchParams,
} from "next/navigation";

import {
  Suspense,
} from "react";

import {
  getSubscriptionPlans,
} from "@/lib/api/subscription/plans";

import {
  getFirebaseCurrentUser,
} from "@/lib/auth/firebase-auth.service";

import {
  bootstrapOnboardingStudio,
  createOnboardingSubscription,
  createOnboardingSubscriptionPayment,
} from "@/lib/api/onboarding/studio-subscription";

import type {
  SubscriptionPlan,
} from "@/types/subscription/plan";

import {
  verifySubscriptionPayment,
} from "@/lib/api/payments";

import {
  processSubscriptionPayment,
} from "@/lib/payments/subscription-payment-gateway";


type PaymentCategory =
  | "upi"
  | "net_banking"
  | "card"
  | null;


type UpiProvider =
  | "google_pay"
  | "phonepe"
  | "paytm"
  | "bhim_upi";


const UPI_PROVIDERS: Array<{
  id: UpiProvider;
  label: string;
  logo: string;
}> = [
  {
    id: "google_pay",
    label: "Google Pay",
    logo: "/payment/upi/google-pay.png",
  },
  {
    id: "phonepe",
    label: "PhonePe",
    logo: "/payment/upi/phonepe.png",
  },
  {
    id: "paytm",
    label: "Paytm",
    logo: "/payment/upi/paytm.png",
  },
  {
    id: "bhim_upi",
    label: "BHIM UPI",
    logo: "/payment/upi/bhim.png",
  },
];


function formatCurrency(
  amount: number,
) {
  return new Intl.NumberFormat(
    "en-IN",
    {
      style: "currency",
      currency: "INR",
      maximumFractionDigits: 0,
    },
  ).format(amount);
}


function StudioOnboardingPaymentContent() {

  const router =
    useRouter();

  const searchParams =
    useSearchParams();


  const planId =
    searchParams.get("planId");

  const planCode =
    searchParams.get("planCode");

  const billingCycle =
    searchParams.get("billingCycle");


  const [
    plans,
    setPlans,
  ] =
    useState<SubscriptionPlan[]>([]);


  const [
    loadingPlan,
    setLoadingPlan,
  ] =
    useState(true);


  const [
    paymentCategory,
    setPaymentCategory,
  ] =
    useState<PaymentCategory>(
      null,
    );


  const [
    upiOpen,
    setUpiOpen,
  ] =
    useState(false);


  const [
    selectedUpiProvider,
    setSelectedUpiProvider,
  ] =
    useState<UpiProvider | null>(
      null,
    );


  const [
    processing,
    setProcessing,
  ] =
    useState(false);


  const [
    paymentError,
    setPaymentError,
  ] =
    useState<string | null>(
      null,
    );


  const [
    success,
    setSuccess,
  ] =
    useState(false);


  useEffect(
    () => {

      let mounted = true;

      async function loadPlans() {

        try {

          const result =
            await getSubscriptionPlans();

          if (mounted) {
            setPlans(result);
          }

        } catch (error) {

          console.error(
            "ONBOARDING PAYMENT PLAN LOAD ERROR:",
            error,
          );

        } finally {

          if (mounted) {
            setLoadingPlan(false);
          }

        }

      }

      void loadPlans();

      return () => {
        mounted = false;
      };

    },
    [],
  );


  const selectedPlan =
    planId
      ? plans.find(
          (plan) =>
            plan.id === planId,
        ) ?? null
      : planCode
        ? plans.find(
            (plan) =>
              plan.plan_code ===
              planCode,
          ) ?? null
        : null;


  function handleBack() {

    router.push(
      `/onboarding/studio?planId=${encodeURIComponent(
        planId ?? "",
      )}&planCode=${encodeURIComponent(
        planCode ?? "",
      )}&billingCycle=${encodeURIComponent(
        billingCycle ?? "",
      )}`,
    );

  }


  async function handlePayment() {

    if (processing) {
      return;
    }


    if (!selectedPlan) {

      setPaymentError(
        "Selected plan could not be found.",
      );

      return;

    }


    if (!paymentCategory) {

      setPaymentError(
        "Please select a payment method.",
      );

      return;

    }


    setPaymentError(null);
    setProcessing(true);


    try {

      const user =
        getFirebaseCurrentUser();


      if (!user) {

        throw new Error(
          "You must be signed in to complete payment.",
        );

      }


      /*
       * ---------------------------------------------------------------
       * 1. Resolve/create the user's studio workspace.
       * ---------------------------------------------------------------
       */

      const studio =
        await bootstrapOnboardingStudio();


      /*
       * ---------------------------------------------------------------
       * 2. Create the selected subscription.
       * ---------------------------------------------------------------
       */

      const subscription =
        await createOnboardingSubscription(
          studio.studio_id,
          selectedPlan.id,
        );


      /*
       * ---------------------------------------------------------------
       * 3. Create the payment record for this subscription.
       * ---------------------------------------------------------------
       */

      const payment =
        await createOnboardingSubscriptionPayment(
          subscription.id,
          Number(
            selectedPlan.price ?? 0,
          ),
        );


      /*
       * ---------------------------------------------------------------
       * 4. Process the gateway transaction.
       *
       * Local development currently uses the existing mock gateway.
       * The real provider can replace this later without changing
       * the onboarding database flow.
       * ---------------------------------------------------------------
       */

      const gatewayResult =
        await processSubscriptionPayment(
          {
            paymentId:
              payment.id,

            amount:
              Number(
                selectedPlan.price ?? 0,
              ),

            currency:
              selectedPlan.currency ??
              "INR",

            planName:
              selectedPlan.name ??
              selectedPlan.plan_code,

            paymentCategory:
              paymentCategory,
          },
        );


      if (
        !gatewayResult.success ||
        !gatewayResult.transactionId
      ) {

        throw new Error(
          gatewayResult.error ??
          "Payment could not be completed.",
        );

      }


      /*
       * ---------------------------------------------------------------
       * 5. Verify the gateway transaction in Supabase.
       * ---------------------------------------------------------------
       */

      await verifySubscriptionPayment(
        payment.id,
        gatewayResult.transactionId,
      );


      /*
       * ---------------------------------------------------------------
       * Payment is considered successful only after backend
       * verification succeeds.
       * ---------------------------------------------------------------
       */

      setSuccess(true);

    } catch (error) {

      console.error(
        "ONBOARDING PAYMENT ERROR:",
        error,
      );

      setPaymentError(
        error instanceof Error
          ? error.message
          : "Unable to process payment.",
      );

    } finally {

      setProcessing(false);

    }

  }


  function handleContinueAfterPayment() {

    router.replace(
      "/legal-compliance",
    );

  }


  if (loadingPlan) {

    return (
      <main className="flex min-h-screen items-center justify-center bg-background">
        <div className="text-sm text-muted-foreground">
          Loading payment...
        </div>
      </main>
    );

  }


  if (!selectedPlan) {

    return (
      <main className="flex min-h-screen items-center justify-center bg-background px-4">
        <section className="w-full max-w-md rounded-2xl border bg-card p-8 text-center">

          <h1 className="text-xl font-semibold">
            Plan not found
          </h1>

          <p className="mt-3 text-sm text-muted-foreground">
            Please go back and select a valid plan.
          </p>

          <button
            type="button"
            onClick={() =>
              router.push("/pricing")
            }
            className="mt-6 inline-flex h-11 items-center justify-center rounded-xl bg-[#0a3f61] px-6 text-sm font-semibold text-white hover:opacity-90"
          >
            Back to Plans
          </button>

        </section>
      </main>
    );

  }


  if (success) {

    return (
      <main className="flex min-h-screen items-center justify-center bg-background px-4 py-8">

        <section className="w-full max-w-lg rounded-2xl border bg-card p-8 text-center shadow-xl sm:p-10">

          <div className="flex justify-center">

            <div className="flex h-20 w-20 items-center justify-center rounded-full bg-[#0a3f61]/10">

              <CheckCircle2 className="h-10 w-10 text-[#0a3f61]" />

            </div>

          </div>

          <h1 className="mt-7 text-2xl font-semibold">
            Payment successful
          </h1>

          <p className="mt-4 text-sm leading-7 text-muted-foreground">
            Your payment has been completed successfully.
            Continue to legal compliance to unlock your PhotoOS workspace.
          </p>

          <button
            type="button"
            onClick={handleContinueAfterPayment}
            className="mt-8 inline-flex h-12 w-full items-center justify-center rounded-xl bg-[#0a3f61] px-6 text-sm font-semibold text-white transition-opacity hover:opacity-90"
          >
            Continue to Legal Compliance
          </button>

        </section>

      </main>
    );

  }


  return (
    <main className="min-h-screen bg-background">

      <div className="mx-auto w-full max-w-2xl px-4 py-8 sm:px-6 lg:py-12">

        <button
          type="button"
          onClick={handleBack}
          disabled={processing}
          className="inline-flex items-center gap-2 rounded-lg px-2 py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground disabled:opacity-50"
        >
          <ChevronLeft className="h-4 w-4" />
          Back to Studio Details
        </button>


        <div className="mt-10 rounded-2xl border bg-card p-6 sm:p-8">

          <div className="border-b pb-6">

            <p className="text-sm text-muted-foreground">
              Selected Plan
            </p>

            <div className="mt-2 flex items-center justify-between gap-4">

              <h1 className="text-2xl font-semibold">
                {selectedPlan.name}
              </h1>

              <div className="text-xl font-bold">
                {formatCurrency(
                  Number(
                    selectedPlan.price ?? 0,
                  ),
                )}
              </div>

            </div>

            <p className="mt-2 text-sm text-muted-foreground">
              {billingCycle ??
                selectedPlan.billing_cycle}
            </p>

            {selectedPlan.trial_days > 0 && (
              <p className="mt-3 text-sm font-medium text-[#0a3f61]">
                {selectedPlan.trial_days} day free trial
              </p>
            )}

          </div>


          <div className="mt-8">

            <h2 className="text-base font-semibold">
              Select payment method
            </h2>


            <div className="mt-4 grid gap-3">

              <div className="overflow-hidden rounded-2xl border">

                <button
                  type="button"
                  onClick={() => {
                    setPaymentCategory("upi");
                    setUpiOpen(
                      (value) => !value,
                    );
                    setPaymentError(null);
                  }}
                  className="flex w-full items-center justify-between gap-4 px-4 py-4 text-left transition-colors hover:bg-muted/40"
                >

                  <div className="flex items-center gap-4">

                    <div className="flex h-11 w-11 items-center justify-center rounded-xl border bg-card">

                      <Smartphone className="h-5 w-5" />

                    </div>

                    <div>

                      <p className="font-semibold">
                        UPI
                      </p>

                      <p className="text-sm text-muted-foreground">
                        Pay with your preferred UPI app
                      </p>

                    </div>

                  </div>

                  {upiOpen ? (
                    <ChevronUp className="h-5 w-5 text-muted-foreground" />
                  ) : (
                    <ChevronDown className="h-5 w-5 text-muted-foreground" />
                  )}

                </button>


                {upiOpen && (

                  <div className="grid gap-3 border-t bg-muted/20 p-4 sm:grid-cols-2">

                    {UPI_PROVIDERS.map(
                      (provider) => {

                        const selected =
                          selectedUpiProvider ===
                          provider.id;

                        return (
                          <button
                            key={provider.id}
                            type="button"
                            onClick={() => {
                              setSelectedUpiProvider(
                                provider.id,
                              );
                              setPaymentCategory(
                                "upi",
                              );
                              setPaymentError(null);
                            }}
                            className={`flex min-h-[76px] items-center justify-between gap-4 rounded-xl border p-4 text-left transition-all ${
                              selected
                                ? "border-2 border-[#0a3f61] bg-[#0a3f61]/5 shadow-sm"
                                : "border bg-card hover:border-[#0a3f61]/40 hover:bg-muted/40"
                            }`}
                          >

                            <div className="flex min-w-0 items-center gap-4">
                              <div className="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border bg-white p-2">
                                <img
                                  src={provider.logo}
                                  alt={`${provider.label} logo`}
                                  className="max-h-8 max-w-8 object-contain"
                                />
                              </div>

                              <span className="font-semibold text-foreground">
                                {provider.label}
                              </span>
                            </div>

                            {selected && (
                              <div className="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#0a3f61]">
                                <Check className="h-4 w-4 text-white" />
                              </div>
                            )}

                          </button>
                        );

                      },
                    )}

                  </div>

                )}

              </div>


              <button
                type="button"
                onClick={() => {
                  setPaymentCategory(
                    "net_banking",
                  );
                  setUpiOpen(false);
                  setSelectedUpiProvider(null);
                  setPaymentError(null);
                }}
                className={`flex w-full items-center gap-4 rounded-2xl border p-4 text-left transition-colors ${
                  paymentCategory ===
                  "net_banking"
                    ? "border-[#0a3f61] bg-[#0a3f61]/5"
                    : "hover:bg-muted/40"
                }`}
              >

                <div className="flex h-11 w-11 items-center justify-center rounded-xl border bg-card">

                  <Landmark className="h-5 w-5" />

                </div>

                <div>

                  <p className="font-semibold">
                    Net Banking
                  </p>

                  <p className="text-sm text-muted-foreground">
                    Pay securely using your bank account
                  </p>

                </div>

                {paymentCategory ===
                  "net_banking" && (
                  <Check className="ml-auto h-5 w-5 text-[#0a3f61]" />
                )}

              </button>


              <button
                type="button"
                onClick={() => {
                  setPaymentCategory("card");
                  setUpiOpen(false);
                  setSelectedUpiProvider(null);
                  setPaymentError(null);
                }}
                className={`flex w-full items-center gap-4 rounded-2xl border p-4 text-left transition-colors ${
                  paymentCategory ===
                  "card"
                    ? "border-[#0a3f61] bg-[#0a3f61]/5"
                    : "hover:bg-muted/40"
                }`}
              >

                <div className="flex h-11 w-11 items-center justify-center rounded-xl border bg-card">

                  <CreditCard className="h-5 w-5" />

                </div>

                <div>

                  <p className="font-semibold">
                    Debit / Credit Card
                  </p>

                  <p className="text-sm text-muted-foreground">
                    Pay using your debit or credit card
                  </p>

                </div>

                {paymentCategory ===
                  "card" && (
                  <Check className="ml-auto h-5 w-5 text-[#0a3f61]" />
                )}

              </button>

            </div>

          </div>


          {paymentError && (

            <div className="mt-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-600">
              {paymentError}
            </div>

          )}


          <button
            type="button"
            onClick={handlePayment}
            disabled={processing}
            className="mt-8 h-12 w-full rounded-xl bg-[#0a3f61] px-6 text-sm font-semibold text-white transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-60"
          >
            {processing
              ? "Processing Payment..."
              : `Pay ${formatCurrency(
                  Number(
                    selectedPlan.price ?? 0,
                  ),
                )}`}
          </button>

        </div>

      </div>

    </main>
  );
}


export default function StudioOnboardingPaymentPage() {

  return (
    <Suspense
      fallback={
        <main className="flex min-h-screen items-center justify-center">
          <div className="text-sm text-muted-foreground">
            Loading payment...
          </div>
        </main>
      }
    >
      <StudioOnboardingPaymentContent />
    </Suspense>
  );

}
