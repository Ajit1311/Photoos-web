"use client";

import { FormEvent, useState } from "react";
import { useRouter } from "next/navigation";
import { signInWithEmail } from "@/lib/auth/firebase-auth.service";

export default function FreelancerLoginPage() {
  const router = useRouter();

  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");

  async function handleSubmit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();

    setError("");

    if (!email.trim() || !password) {
      setError("Please enter your login ID and password.");
      return;
    }

    setLoading(true);

    try {
      await signInWithEmail(email.trim(), password);
      router.replace("/freelancer/dashboard");
    } catch (loginError) {
      console.error("FREELANCER LOGIN ERROR:", loginError);

      setError(
        loginError instanceof Error
          ? loginError.message
          : "Unable to sign in. Please check your login details.",
      );
    } finally {
      setLoading(false);
    }
  }

  return (
    <main className="min-h-screen bg-slate-50 px-4 py-8">
      <div className="flex min-h-[calc(100vh-4rem)] items-center justify-center">
        <div className="w-full max-w-md">
          <div className="rounded-[28px] border border-slate-200 bg-white p-7 shadow-xl shadow-slate-200/50 sm:p-9">
            <div className="text-center">
              <div className="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-[#0A3F61] text-2xl font-black text-white">
                P
              </div>

              <h1 className="mt-6 text-3xl font-black tracking-tight text-slate-950">
                Freelancer Login
              </h1>

              <p className="mt-2 text-sm leading-6 text-slate-500">
                Sign in to manage your PhotoOS booking requests.
              </p>
            </div>

            <form onSubmit={handleSubmit} className="mt-8 space-y-5">
              <div>
                <label
                  htmlFor="freelancer-email"
                  className="mb-2 block text-sm font-semibold text-slate-700"
                >
                  Login ID
                </label>

                <input
                  id="freelancer-email"
                  type="email"
                  autoComplete="email"
                  value={email}
                  onChange={(event) => setEmail(event.target.value)}
                  placeholder="your@email.com"
                  className="h-12 w-full rounded-xl border border-slate-200 bg-white px-4 text-sm text-slate-950 outline-none transition focus:border-[#0A3F61] focus:ring-4 focus:ring-[#0A3F61]/10"
                />
              </div>

              <div>
                <label
                  htmlFor="freelancer-password"
                  className="mb-2 block text-sm font-semibold text-slate-700"
                >
                  Password
                </label>

                <input
                  id="freelancer-password"
                  type="password"
                  autoComplete="current-password"
                  value={password}
                  onChange={(event) => setPassword(event.target.value)}
                  placeholder="Enter your password"
                  className="h-12 w-full rounded-xl border border-slate-200 bg-white px-4 text-sm text-slate-950 outline-none transition focus:border-[#0A3F61] focus:ring-4 focus:ring-[#0A3F61]/10"
                />
              </div>

              {error ? (
                <div className="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm leading-5 text-red-700">
                  {error}
                </div>
              ) : null}

              <button
                type="submit"
                disabled={loading}
                className="flex h-12 w-full items-center justify-center rounded-xl bg-[#0A3F61] px-5 text-sm font-bold text-white transition hover:bg-[#08344f] disabled:cursor-not-allowed disabled:opacity-60"
              >
                {loading ? "Signing in..." : "Sign In"}
              </button>
            </form>

            <div className="mt-7 rounded-xl bg-slate-50 px-4 py-3 text-center text-xs leading-5 text-slate-500">
              Use the Login ID and Password received in your
              PhotoOS congratulations email.
            </div>
          </div>

          <p className="mt-6 text-center text-xs text-slate-400">
            © 2026 PhotoOS · Freelancer Portal
          </p>
        </div>
      </div>
    </main>
  );
}
