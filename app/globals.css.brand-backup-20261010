/* Interactive elements */
button,
a,
[role="button"],
input[type="button"],
input[type="submit"],
input[type="reset"],
select,
summary {
  cursor: pointer;
}

/* Disabled controls should not show a hand cursor */
button:disabled,
input:disabled,
select:disabled,
[aria-disabled="true"] {
  cursor: not-allowed;
}



/* PhotoOS premium plan card scrollbar */

.photoos-plan-scroll {
  scrollbar-width: thin;
  scrollbar-color: rgb(148 163 184) transparent;
  scrollbar-gutter: stable;
  scroll-behavior: smooth;
  overscroll-behavior: contain;
}

.photoos-plan-scroll::-webkit-scrollbar {
  width: 5px;
}

.photoos-plan-scroll::-webkit-scrollbar-track {
  background: transparent;
  border-radius: 9999px;
}

.photoos-plan-scroll::-webkit-scrollbar-thumb {
  background: rgb(148 163 184);
  border-radius: 9999px;
  min-height: 22px;
}

.photoos-plan-scroll::-webkit-scrollbar-thumb:hover {
  background: rgb(100 116 139);
}

@media (max-width: 1279px) {
  .photoos-plan-scroll::-webkit-scrollbar {
    width: 4px;
  }
}

@media (max-width: 1023px) {
  .photoos-plan-scroll {
    scrollbar-width: none;
  }

  .photoos-plan-scroll::-webkit-scrollbar {
    display: none;
  }
}

/* ============================================================
   LEGAL AGREEMENT SCROLL EXPERIENCE
   ============================================================ */

.legal-agreement-scroll {
  scrollbar-width: auto;
  scrollbar-color: #0a3f61 #e8eef3;
}

.legal-agreement-scroll::-webkit-scrollbar {
  width: 12px;
}

.legal-agreement-scroll::-webkit-scrollbar-track {
  margin: 10px 6px;
  border-radius: 9999px;
  background: #e8eef3;
}

.legal-agreement-scroll::-webkit-scrollbar-thumb {
  border: 3px solid #e8eef3;
  border-radius: 9999px;
  background: #0a3f61;
}

.legal-agreement-scroll::-webkit-scrollbar-thumb:hover {
  background: #083653;
}
