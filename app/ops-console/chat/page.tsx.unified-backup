"use client";

import {
  FormEvent,
  useEffect,
  useMemo,
  useState,
} from "react";

import {
  CheckCheck,
  Loader2,
  MessageSquare,
  Plus,
  Search,
  Send,
  ShieldCheck,
  UserRound,
} from "lucide-react";

import {
  createInternalChatConversation,
  getInternalChatConversations,
  getInternalChatEmployees,
  getInternalChatMessages,
  sendInternalChatMessage,
  type InternalChatConversation,
  type InternalChatEmployee,
  type InternalChatMessage,
} from "@/lib/api/platform-admin-internal-chat";

export default function AdminInternalChatPage() {
  const [employees, setEmployees] =
    useState<InternalChatEmployee[]>([]);

  const [conversations, setConversations] =
    useState<InternalChatConversation[]>([]);

  const [messages, setMessages] =
    useState<InternalChatMessage[]>([]);

  const [selectedConversationId, setSelectedConversationId] =
    useState<string | null>(null);

  const [search, setSearch] =
    useState("");

  const [message, setMessage] =
    useState("");

  const [loading, setLoading] =
    useState(true);

  const [messagesLoading, setMessagesLoading] =
    useState(false);

  const [sending, setSending] =
    useState(false);

  const [creating, setCreating] =
    useState(false);

  const [error, setError] =
    useState("");

  const [showEmployees, setShowEmployees] =
    useState(false);

  async function loadChat() {
    setLoading(true);
    setError("");

    try {
      const employeeData =
        await getInternalChatEmployees();

      console.log(
        "[Internal Chat] employees:",
        employeeData,
      );

      setEmployees(
        Array.isArray(employeeData)
          ? employeeData
          : [],
      );
    } catch (err) {
      console.error(
        "[Internal Chat] employees failed:",
        err,
      );

      setEmployees([]);

      setError(
        err instanceof Error
          ? err.message
          : "Unable to load employees.",
      );
    }

    try {
      const conversationData =
        await getInternalChatConversations();

      console.log(
        "[Internal Chat] conversations:",
        conversationData,
      );

      setConversations(
        Array.isArray(conversationData)
          ? conversationData
          : [],
      );

      if (
        selectedConversationId &&
        conversationData.some(
          (conversation) =>
            conversation.conversation_id ===
            selectedConversationId,
        )
      ) {
        return;
      }

      if (conversationData.length > 0) {
        setSelectedConversationId(
          conversationData[0].conversation_id,
        );
      }
    } catch (err) {
      console.error(
        "[Internal Chat] conversations failed:",
        err,
      );

      setConversations([]);
    } finally {
      setLoading(false);
    }
  }

  async function loadMessages(
    conversationId: string,
  ) {
    setMessagesLoading(true);
    setError("");

    try {
      const data =
        await getInternalChatMessages(
          conversationId,
        );

      setMessages(data);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Unable to load messages.",
      );
      setMessages([]);
    } finally {
      setMessagesLoading(false);
    }
  }

  useEffect(() => {
    void loadChat();
  }, []);

  useEffect(() => {
    if (!selectedConversationId) {
      setMessages([]);
      return;
    }

    void loadMessages(
      selectedConversationId,
    );
  }, [selectedConversationId]);

  const filteredEmployees =
    useMemo(
      () => {
        const value =
          search.trim().toLowerCase();

        if (!value) {
          return employees;
        }

        return employees.filter(
          (employee) =>
            employee.display_name
              ?.toLowerCase()
              .includes(value) ||
            employee.email
              .toLowerCase()
              .includes(value) ||
            employee.employee_code
              ?.toLowerCase()
              .includes(value),
        );
      },
      [employees, search],
    );

  const selectedConversation =
    conversations.find(
      (conversation) =>
        conversation.conversation_id ===
        selectedConversationId,
    );

  const selectedEmployee =
    selectedConversation?.members
      ?.map((member) =>
        employees.find(
          (employee) =>
            employee.profile_id ===
            member.profile_id,
        ),
      )
      .find(Boolean);

  async function startConversation(
    employee: InternalChatEmployee,
  ) {
    setCreating(true);
    setError("");

    try {
      const conversationId =
        await createInternalChatConversation(
          employee.profile_id,
        );

      await loadChat();

      setSelectedConversationId(
        conversationId,
      );

      setShowEmployees(false);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Unable to start conversation.",
      );
    } finally {
      setCreating(false);
    }
  }

  async function handleSend(
    event: FormEvent<HTMLFormElement>,
  ) {
    event.preventDefault();

    const content = message.trim();

    if (
      !content ||
      !selectedConversationId ||
      sending
    ) {
      return;
    }

    setSending(true);
    setError("");

    try {
      await sendInternalChatMessage(
        selectedConversationId,
        content,
      );

      setMessage("");

      await loadMessages(
        selectedConversationId,
      );
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Unable to send message.",
      );
    } finally {
      setSending(false);
    }
  }

  function formatTime(
    value: string,
  ) {
    return new Intl.DateTimeFormat(
      "en-IN",
      {
        hour: "2-digit",
        minute: "2-digit",
      },
    ).format(new Date(value));
  }

  return (
    <div className="flex h-[calc(100vh-5rem)] min-h-[620px] overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      {/* Conversations */}
      <aside className="flex w-[310px] shrink-0 flex-col border-r border-slate-200 bg-slate-50/60">
        <div className="border-b border-slate-200 p-4">
          <div className="flex items-center justify-between">
            <div>
              <h1 className="text-lg font-semibold text-slate-900">
                Internal Chat
              </h1>
              <p className="mt-0.5 text-xs text-slate-500">
                Platform Admin Team
              </p>
            </div>

            <button
              type="button"
              onClick={() =>
                setShowEmployees(true)
              }
              className="flex h-9 w-9 items-center justify-center rounded-xl bg-[#0A3F61] text-white transition hover:opacity-90"
              title="New conversation"
            >
              <Plus size={18} />
            </button>
          </div>

          <div className="relative mt-4">
            <Search
              size={16}
              className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"
            />

            <input
              value={search}
              onChange={(event) =>
                setSearch(event.target.value)
              }
              placeholder="Search employees..."
              className="w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-9 pr-3 text-sm outline-none focus:border-[#0A3F61]"
            />
          </div>
        </div>

        <div className="flex-1 overflow-y-auto">
          {loading ? (
            <div className="flex items-center justify-center p-8 text-slate-400">
              <Loader2
                size={20}
                className="animate-spin"
              />
            </div>
          ) : conversations.length === 0 ? (
            <div className="p-6 text-center">
              <MessageSquare
                size={28}
                className="mx-auto text-slate-300"
              />

              <p className="mt-3 text-sm font-medium text-slate-600">
                No conversations
              </p>

              <p className="mt-1 text-xs text-slate-400">
                Start a chat with an employee.
              </p>

              <button
                type="button"
                onClick={() =>
                  setShowEmployees(true)
                }
                className="mt-4 rounded-xl bg-[#0A3F61] px-4 py-2 text-xs font-medium text-white"
              >
                Start Chat
              </button>
            </div>
          ) : (
            conversations.map(
              (conversation) => {
                const employee =
                  conversation.members
                    ?.map((member) =>
                      employees.find(
                        (item) =>
                          item.profile_id ===
                          member.profile_id,
                      ),
                    )
                    .find(Boolean);

                const active =
                  conversation.conversation_id ===
                  selectedConversationId;

                return (
                  <button
                    key={conversation.conversation_id}
                    type="button"
                    onClick={() =>
                      setSelectedConversationId(
                        conversation.conversation_id,
                      )
                    }
                    className={`flex w-full items-center gap-3 border-b border-slate-100 px-4 py-3.5 text-left transition ${
                      active
                        ? "bg-white"
                        : "hover:bg-white/70"
                    }`}
                  >
                    <div className="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#0A3F61]/10 text-sm font-semibold text-[#0A3F61]">
                      {(
                        employee?.display_name ??
                        employee?.email ??
                        "E"
                      )
                        .charAt(0)
                        .toUpperCase()}
                    </div>

                    <div className="min-w-0 flex-1">
                      <div className="truncate text-sm font-medium text-slate-800">
                        {employee?.display_name ??
                          employee?.email ??
                          "Employee"}
                      </div>

                      <div className="mt-0.5 truncate text-xs text-slate-400">
                        {employee?.employee_code ??
                          employee?.email}
                      </div>
                    </div>

                    {active ? (
                      <div className="h-2 w-2 rounded-full bg-[#0A3F61]" />
                    ) : null}
                  </button>
                );
              },
            )
          )}
        </div>
      </aside>

      {/* Chat */}
      <section className="flex min-w-0 flex-1 flex-col">
        {!selectedConversationId ? (
          <div className="flex flex-1 flex-col items-center justify-center text-center">
            <div className="flex h-16 w-16 items-center justify-center rounded-2xl bg-slate-100">
              <MessageSquare
                size={28}
                className="text-slate-400"
              />
            </div>

            <h2 className="mt-4 text-base font-semibold text-slate-800">
              Internal Team Chat
            </h2>

            <p className="mt-1 max-w-sm text-sm text-slate-400">
              Select an employee or start a new conversation.
            </p>
          </div>
        ) : (
          <>
            <header className="flex items-center gap-3 border-b border-slate-200 px-5 py-4">
              <div className="flex h-10 w-10 items-center justify-center rounded-full bg-[#0A3F61]/10 text-[#0A3F61]">
                <UserRound size={19} />
              </div>

              <div>
                <h2 className="text-sm font-semibold text-slate-900">
                  {selectedEmployee?.display_name ??
                    selectedEmployee?.email ??
                    "Employee"}
                </h2>

                <p className="text-xs text-slate-400">
                  {selectedEmployee?.employee_code ??
                    "Platform Admin Employee"}
                </p>
              </div>

              <div className="ml-auto flex items-center gap-1.5 rounded-full bg-slate-50 px-3 py-1.5 text-[11px] text-slate-500">
                <ShieldCheck
                  size={14}
                  className="text-emerald-600"
                />
                Encrypted
              </div>
            </header>

            <div className="flex-1 overflow-y-auto bg-[#F8FAFC] px-5 py-6">
              {messagesLoading ? (
                <div className="flex h-full items-center justify-center">
                  <Loader2
                    size={22}
                    className="animate-spin text-slate-400"
                  />
                </div>
              ) : messages.length === 0 ? (
                <div className="flex h-full items-center justify-center">
                  <div className="text-center">
                    <MessageSquare
                      size={30}
                      className="mx-auto text-slate-300"
                    />

                    <p className="mt-3 text-sm text-slate-500">
                      No messages yet
                    </p>

                    <p className="mt-1 text-xs text-slate-400">
                      Start the conversation below.
                    </p>
                  </div>
                </div>
              ) : (
                <div className="mx-auto flex max-w-3xl flex-col gap-3">
                  {messages.map(
                    (item) => {
                      const mine =
                        item.sender_id ===
                        selectedConversation?.members?.[0]?.profile_id;

                      return (
                        <div
                          key={item.id}
                          className={`flex ${
                            mine
                              ? "justify-end"
                              : "justify-start"
                          }`}
                        >
                          <div
                            className={`max-w-[75%] rounded-2xl px-4 py-2.5 shadow-sm ${
                              mine
                                ? "rounded-br-md bg-[#0A3F61] text-white"
                                : "rounded-bl-md border border-slate-200 bg-white text-slate-800"
                            }`}
                          >
                            <p className="whitespace-pre-wrap break-words text-sm">
                              {item.decryption_failed
                                ? "Unable to decrypt this message."
                                : item.content ?? ""}
                            </p>

                            <div
                              className={`mt-1.5 flex items-center justify-end gap-1 text-[10px] ${
                                mine
                                  ? "text-white/60"
                                  : "text-slate-400"
                              }`}
                            >
                              {formatTime(
                                item.created_at,
                              )}

                              {mine ? (
                                <CheckCheck
                                  size={12}
                                />
                              ) : null}
                            </div>
                          </div>
                        </div>
                      );
                    },
                  )}
                </div>
              )}
            </div>

            <div className="border-t border-slate-200 bg-white">
              <div className="border-b border-slate-100 px-5 py-2 text-center text-[11px] text-slate-400">
                🔒 Messages are encrypted with AES-256-GCM
              </div>

              {error ? (
                <div className="mx-5 mt-3 rounded-xl border border-red-200 bg-red-50 px-3 py-2 text-xs text-red-600">
                  {error}
                </div>
              ) : null}

              <form
                onSubmit={handleSend}
                className="flex items-end gap-3 p-4"
              >
                <textarea
                  value={message}
                  onChange={(event) =>
                    setMessage(event.target.value)
                  }
                  onKeyDown={(event) => {
                    if (
                      event.key === "Enter" &&
                      !event.shiftKey
                    ) {
                      event.preventDefault();

                      if (!sending) {
                        event.currentTarget.form?.requestSubmit();
                      }
                    }
                  }}
                  rows={1}
                  placeholder="Write a message..."
                  className="max-h-32 min-h-11 flex-1 resize-none rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none focus:border-[#0A3F61] focus:ring-2 focus:ring-[#0A3F61]/10"
                />

                <button
                  type="submit"
                  disabled={
                    sending ||
                    !message.trim()
                  }
                  className="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[#0A3F61] text-white transition hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
                >
                  {sending ? (
                    <Loader2
                      size={18}
                      className="animate-spin"
                    />
                  ) : (
                    <Send size={18} />
                  )}
                </button>
              </form>
            </div>
          </>
        )}
      </section>

      {/* Employee picker */}
      {showEmployees ? (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/30 p-5">
          <div className="w-full max-w-md overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl">
            <div className="flex items-center justify-between border-b border-slate-200 px-5 py-4">
              <div>
                <h3 className="font-semibold text-slate-900">
                  New Conversation
                </h3>

                <p className="mt-0.5 text-xs text-slate-400">
                  Select a platform employee
                </p>
              </div>

              <button
                type="button"
                onClick={() =>
                  setShowEmployees(false)
                }
                className="rounded-lg px-2 py-1 text-sm text-slate-400 hover:bg-slate-100"
              >
                ✕
              </button>
            </div>

            <div className="max-h-[420px] overflow-y-auto p-3">
              {filteredEmployees.length === 0 ? (
                <div className="p-6 text-center text-sm text-slate-400">
                  No employees found.
                </div>
              ) : (
                filteredEmployees.map(
                  (employee) => (
                    <button
                      key={employee.id}
                      type="button"
                      disabled={creating}
                      onClick={() =>
                        void startConversation(
                          employee,
                        )
                      }
                      className="flex w-full items-center gap-3 rounded-xl p-3 text-left transition hover:bg-slate-50 disabled:opacity-50"
                    >
                      <div className="flex h-10 w-10 items-center justify-center rounded-full bg-[#0A3F61]/10 text-sm font-semibold text-[#0A3F61]">
                        {(
                          employee.display_name ??
                          employee.email
                        )
                          .charAt(0)
                          .toUpperCase()}
                      </div>

                      <div className="min-w-0 flex-1">
                        <div className="truncate text-sm font-medium text-slate-800">
                          {employee.display_name ??
                            employee.email}
                        </div>

                        <div className="truncate text-xs text-slate-400">
                          {employee.employee_code ??
                            employee.email}
                        </div>
                      </div>

                      {creating ? (
                        <Loader2
                          size={16}
                          className="animate-spin text-slate-400"
                        />
                      ) : (
                        <Plus
                          size={16}
                          className="text-slate-400"
                        />
                      )}
                    </button>
                  ),
                )
              )}
            </div>
          </div>
        </div>
      ) : null}
    </div>
  );
}
