function getInitial(
  name:
    string | null | undefined,
) {

  const value =
    name?.trim() ?? "";

  return (
    value.charAt(
      0,
    ).toUpperCase() ||
    "S"
  );

}


function normalizeValue(
  value:
    string | null | undefined,
) {

  return value ?? "";

}


