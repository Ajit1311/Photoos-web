                (
                  event
                ) =>
                  updateField(
                    "contact_email",
                    event.target.value,
                  )
              }
              className="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-[#0A3F61] disabled:bg-slate-50"
            />

          </div>


          <div>

            <label className="mb-2 flex items-center gap-2 text-sm font-semibold text-slate-700">

              <Phone
                size={16}
              />

              Phone

            </label>


            <input
              type="tel"
              value={
                normalizeValue(
                  displayProfile.contact_phone,
                )
              }
              disabled={
                !editing
              }
              onChange={
                (
                  event
                ) =>
                  updateField(
                    "contact_phone",
                    event.target.value,
                  )
              }
              className="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-[#0A3F61] disabled:bg-slate-50"
            />

          </div>


          <div className="sm:col-span-2">

            <label className="mb-2 flex items-center gap-2 text-sm font-semibold text-slate-700">

              <Globe
                size={16}
              />

              Website

            </label>


            <input
              type="url"
              placeholder="https://example.com"
              value={
                normalizeValue(
                  displayProfile.website,
                )
              }
              disabled={
                !editing
              }
              onChange={
                (
                  event
                ) =>
                  updateField(
                    "website",
                    event.target.value,
                  )
              }
              className="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-[#0A3F61] disabled:bg-slate-50"
            />

          </div>

        </div>

      </section>


      <section className="rounded-3xl border border-slate-200 bg-white shadow-sm">

        <div className="border-b border-slate-100 px-6 py-6 sm:px-8">

          <h2 className="text-lg font-bold text-slate-900">

            Studio address

          </h2>

        </div>


        <div className="grid gap-5 p-6 sm:grid-cols-2 sm:p-8">

          <div className="sm:col-span-2">

            <label className="mb-2 flex items-center gap-2 text-sm font-semibold text-slate-700">

              <MapPin
                size={16}
              />

              Address

            </label>


            <input
              value={
                normalizeValue(
                  displayProfile.address,
                )
              }
              disabled={
                !editing
              }
              onChange={
                (
                  event
                ) =>
                  updateField(
                    "address",
                    event.target.value,
                  )
              }
              className="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-[#0A3F61] disabled:bg-slate-50"
            />

          </div>


          {[
            [
              "City",
              "city",
            ],
            [
              "State",
              "state",
            ],
            [
              "Country",
              "country",
            ],
            [
              "Postal code",
              "postal_code",
            ],
          ].map(
            (
              [
                label,
                field,
              ]
            ) => (

              <div
                key={
                  field
                }
              >

                <label className="mb-2 block text-sm font-semibold text-slate-700">

                  {label}

                </label>


                <input
                  value={
                    normalizeValue(
                      displayProfile[
                        field as keyof typeof displayProfile
                      ] as string | null | undefined,
                    )
                  }
                  disabled={
                    !editing
                  }
                  onChange={
                    (
                      event
                    ) =>
                      updateField(
                        field as keyof UpdateStudioProfileInput,
                        event.target.value,
                      )
                  }
                  className="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-[#0A3F61] disabled:bg-slate-50"
                />

              </div>

            ),
          )}

        </div>

      </section>


      <section className="rounded-3xl border border-slate-200 bg-white shadow-sm">

        <div className="border-b border-slate-100 px-6 py-6 sm:px-8">

          <h2 className="text-lg font-bold text-slate-900">

            Social media links

          </h2>


          <p className="mt-1 text-sm text-slate-500">

            Add your studio social profiles.

          </p>

        </div>


        <div className="grid gap-5 p-6 sm:p-8">

          <div>

            <label className="mb-2 block text-sm font-semibold text-slate-700">

              Instagram

            </label>


            <input
              type="url"
              placeholder="https://instagram.com/yourstudio"
              value={
                normalizeValue(
                  displayProfile.instagram_url,
                )
              }
              disabled={
                !editing
              }
              onChange={
                (
                  event
                ) =>
                  updateField(
                    "instagram_url",
                    event.target.value,
                  )
              }
              className="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-[#0A3F61] disabled:bg-slate-50"
            />

          </div>


          <div>

            <label className="mb-2 block text-sm font-semibold text-slate-700">

              Facebook

            </label>


            <input
              type="url"
              placeholder="https://facebook.com/yourstudio"
              value={
                normalizeValue(
                  displayProfile.facebook_url,
                )
              }
              disabled={
                !editing
              }
              onChange={
                (
                  event
                ) =>
                  updateField(
                    "facebook_url",
                    event.target.value,
                  )
              }
              className="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-[#0A3F61] disabled:bg-slate-50"
            />

          </div>


          <div>

            <label className="mb-2 block text-sm font-semibold text-slate-700">

              YouTube

            </label>


            <input
              type="url"
              placeholder="https://youtube.com/@yourstudio"
              value={
                normalizeValue(
                  displayProfile.youtube_url,
                )
              }
              disabled={
                !editing
              }
              onChange={
                (
                  event
                ) =>
                  updateField(
                    "youtube_url",
                    event.target.value,
                  )
              }
              className="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-[#0A3F61] disabled:bg-slate-50"
            />

          </div>

        </div>

      </section>


      {editing && (

        <div className="flex justify-end gap-3 pb-6">

          <button
            type="button"
            onClick={
              handleCancelEdit
            }
            disabled={
              saving ||
              uploadingLogo
            }
            className="rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 disabled:opacity-60"
          >

            Cancel

          </button>


          <button
            type="button"
            onClick={
              handleSave
            }
            disabled={
              saving ||
              uploadingLogo
            }
            className="inline-flex items-center gap-2 rounded-xl bg-[#0A3F61] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#083652] disabled:cursor-not-allowed disabled:opacity-60"
          >

            {saving
              ? (

                <Loader2
                  size={18}
                  className="animate-spin"
                />

              )
              : (

                <Save
                  size={18}
                />

              )}

            Save profile

          </button>

        </div>

      )}


      {cropImage && (

        <div className="fixed inset-0 z-[100] flex items-center justify-center bg-slate-950/80 p-4">

          <div className="flex max-h-[90vh] w-full max-w-2xl flex-col overflow-hidden rounded-3xl bg-white shadow-2xl">

            <div className="flex items-center justify-between border-b border-slate-200 px-6 py-5">

              <div>

                <h2 className="text-lg font-bold text-slate-900">

                  Crop studio logo

                </h2>


                <p className="mt-1 text-sm text-slate-500">

                  Adjust the image before uploading it.

                </p>

              </div>


              <button
                type="button"
                onClick={
                  closeLogoCropper
                }
                disabled={
                  uploadingLogo
                }
                className="flex h-10 w-10 items-center justify-center rounded-xl text-slate-500 transition hover:bg-slate-100"
              >

                <X
                  size={20}
                />

              </button>

            </div>


            <div className="relative h-[420px] bg-slate-950">

              <Cropper
                image={
                  cropImage
                }
                crop={
                  crop
                }
                zoom={
                  zoom
                }
                aspect={
                  1
                }
                cropShape="round"
                showGrid={
                  false
                }
                onCropChange={
                  setCrop
                }
                onZoomChange={
                  setZoom
                }
                onCropComplete={
                  handleCropComplete
                }
              />

            </div>


            <div className="space-y-3 border-t border-slate-100 px-6 py-5">

              <div className="flex items-center gap-4">

                <span className="text-sm font-medium text-slate-600">

                  Zoom

                </span>


                <input
                  type="range"
                  min="1"
                  max="3"
                  step="0.05"
                  value={
                    zoom
                  }
                  onChange={
                    (
                      event
                    ) =>
                      setZoom(
                        Number(
                          event.target.value,
                        ),
                      )
                  }
                  className="flex-1 accent-[#0A3F61]"
                />

              </div>


              <div className="flex justify-end gap-3 pt-2">

                <button
                  type="button"
                  onClick={
                    closeLogoCropper
                  }
                  disabled={
                    uploadingLogo
                  }
                  className="rounded-xl border border-slate-200 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
                >

                  Cancel

                </button>


                <button
                  type="button"
                  onClick={
                    confirmLogoCrop
                  }
                  disabled={
                    uploadingLogo
                  }
                  className="inline-flex items-center gap-2 rounded-xl bg-[#0A3F61] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#083652] disabled:opacity-60"
                >

                  {uploadingLogo && (

                    <Loader2
                      size={18}
                      className="animate-spin"
                    />

                  )}

                  {uploadingLogo
                    ? "Uploading..."
                    : "Crop and upload"}

                </button>

              </div>

            </div>

          </div>

        </div>

      )}

    </div>

  );

}
