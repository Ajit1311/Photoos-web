"use client";

import { useState, useEffect } from "react";
import Link from "next/link";
import { Search } from "lucide-react";

import { useProjects } from "@/hooks/useProjects";
import { useBootstrapContext } from "@/context/BootstrapContext";
import ProjectsTable from "@/components/projects/ProjectsTable";
import { useDebounce } from "@/hooks/useDebounce";
import ProjectsPagination from "@/components/projects/ProjectsPagination";

export default function ProjectsPage() {
  const { data: bootstrap } = useBootstrapContext();

  console.log(bootstrap);

  const [search, setSearch] = useState("");
  const [page, setPage] = useState(1);

  const debouncedSearch = useDebounce(search, 500);

  // Search बदल्ल्यावर Page 1 वर रिसेट करण्यासाठी
  useEffect(() => {
    setPage(1);
  }, [debouncedSearch]);

  const { data, loading, error, reload } = useProjects({
    page,
    search: debouncedSearch,
  });

  if (loading) {
    return (
      <main className="flex items-center justify-center py-20">
        <p className="text-slate-500">Loading projects...</p>
      </main>
    );
  }

  if (error) {
    return (
      <main className="space-y-6 p-8">
        <div className="rounded-xl border border-red-200 bg-red-50 p-6">
          <h2 className="text-lg font-semibold text-red-700">
            Failed to load projects
          </h2>

          <p className="mt-2 text-sm text-red-600">{error.message}</p>

          <button
            onClick={() => {
              void reload();
            }}
            className="mt-4 rounded-lg bg-red-600 px-4 py-2 text-white"
          >
            Retry
          </button>
        </div>
      </main>
    );
  }

  const projects = data?.projects ?? [];
  const totalProjects = data?.pagination?.total ?? projects.length;
  const totalPages = data?.pagination?.totalPages ?? 1;

  return (
    <main className="space-y-8 p-8">
      <div className="flex items-center justify-between gap-4">
        <div>
          <h1 className="text-3xl font-bold">Projects</h1>

          <p className="mt-2 text-slate-500">
            Total Projects: {totalProjects}
          </p>
        </div>

        <div className="flex items-center gap-3">
          <button
            onClick={() => {
              void reload();
            }}
            className="rounded-xl border px-5 py-3 font-medium transition hover:bg-slate-50"
          >
            Refresh
          </button>

          <Link
            href="/dashboard/projects/create"
            className="rounded-xl bg-[#0A3F61] px-5 py-3 font-medium text-white transition hover:opacity-90"
          >
            New Project
          </Link>
        </div>
      </div>

      <div className="flex items-center justify-between gap-4">
        <div className="relative w-full max-w-md">
          <Search className="absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" />

          <input
            type="text"
            value={search}
            onChange={(event) => {
              setSearch(event.target.value);
            }}
            placeholder="Search projects..."
            className="w-full rounded-xl border py-3 pl-11 pr-4 outline-none transition focus:border-[#0A3F61]"
          />
        </div>

        <p className="text-sm text-slate-500">
          Showing {projects.length} of {data?.pagination?.total ?? 0} project(s)
        </p>
      </div>

      <ProjectsTable projects={projects} />

      {/* Pagination Component */}
      <ProjectsPagination
        page={page}
        totalPages={totalPages}
        onPrevious={() => {
          setPage((current) => Math.max(1, current - 1));
        }}
        onNext={() => {
          setPage((current) => Math.min(totalPages, current + 1));
        }}
      />
    </main>
  );
}