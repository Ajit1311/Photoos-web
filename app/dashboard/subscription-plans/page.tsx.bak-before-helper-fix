                      )}


                      {limits.length >
                        0 && (
                        <div className="mt-6 border-t pt-6">
                          <h3 className="text-sm font-semibold">
                            {addon
                              ? "Add-on Capacity"
                              : "Plan Limits"}
                          </h3>

                          <dl className="mt-4 space-y-3">
                            {limits.map(
                              (
                                limit,
                              ) => (
                                <div
                                  key={
                                    limit.label
                                  }
                                  className="flex items-center justify-between gap-4 text-sm"
                                >
                                  <dt className="text-muted-foreground">
                                    {limit.label}
                                  </dt>

                                  <dd className="font-semibold">
                                    {limit.value}
                                  </dd>
                                </div>
                              ),
                            )}
                          </dl>
                        </div>
                      )}


                      <div className="mt-auto pt-8">
                        <Link
                          href={`/dashboard/plans/payment?planId=${encodeURIComponent(
                            plan.id,
                          )}&planCode=${encodeURIComponent(
                            plan.plan_code,
                          )}&planType=${encodeURIComponent(
                            addon
                              ? "addon"
                              : "subscription",
                          )}`}
                          className="inline-flex w-full items-center justify-center rounded-xl bg-[#0a3f61] px-4 py-3 text-sm font-semibold text-white transition-opacity hover:opacity-90"
                        >
                          {addon
                            ? "Choose Add-on"
                            : "Choose Plan"}
                        </Link>
                      </div>
                    </div>
                  );
                },
              )}
            </div>
          )}


        <div className="mt-10 rounded-2xl border bg-card p-6">
          <div className="flex gap-4">
            <ShieldCheck className="h-5 w-5 shrink-0 text-[#0a3f61]" />

            <div>
              <h3 className="font-semibold">
                Subscription and add-on management
              </h3>

              <p className="mt-1 text-sm leading-6 text-muted-foreground">
                Base plans and add-on products are loaded
                from the same PhotoOS subscription catalog.
                Add-ons do not replace the current base
                subscription.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}
