                      </div>


                      {features.length >
                        0 && (
                        <div className="mt-6 border-t pt-6">
                          <h3 className="text-sm font-semibold">
                            Included Features
                          </h3>

                          <ul className="mt-4 space-y-3">
                            {features.map(
                              (
                                feature,
                              ) => (
                                <li
                                  key={
                                    feature
