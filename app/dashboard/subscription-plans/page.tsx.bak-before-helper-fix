  };


const formatFeatureName = (
  value: string,
) => {
  const normalizedValue =
    value
      .trim()
      .toLowerCase();

  if (
    featureLabels[
      normalizedValue
    ]
  ) {
    return featureLabels[
      normalizedValue
    ];
  }

  return normalizedValue
    .replace(
      /_/g,
      " ",
    )
    .replace(
      /\b\w/g,
      (
        character,
      ) =>
        character.toUpperCase(),
    );
};


const formatLimitValue = (
  key: string,
  value: unknown,
): string => {
  if (
    value === -1 ||
    value === "-1"
  ) {
    return "Unlimited";
  }

  const numericValue =
    typeof value === "number"
      ? value
      : Number(
          value,
        );

  if (
    key === "storage_gb" &&
    !Number.isNaN(
      numericValue,
    )
  ) {
    return `${numericValue.toLocaleString()} GB`;
  }

  if (
    key === "watermark_photos" &&
    !Number.isNaN(
      numericValue,
    )
  ) {
    return `${numericValue.toLocaleString()} Photos`;
  }

  if (
    key === "events_per_month" &&
    !Number.isNaN(
      numericValue,
    )
  ) {
    return `${numericValue.toLocaleString()} Events`;
  }

  if (
    key === "users" &&
    !Number.isNaN(
      numericValue,
    )
  ) {
    return `${numericValue.toLocaleString()} Users`;
  }

  if (
    key === "portfolio_images" &&
    !Number.isNaN(
      numericValue,
    )
  ) {
    return `${numericValue.toLocaleString()} Images`;
  }

  if (
    key === "services" &&
    !Number.isNaN(
      numericValue,
    )
  ) {
    return `${numericValue.toLocaleString()} Services`;
  }

  if (
    typeof value === "boolean"
  ) {
    return value
      ? "Included"
      : "Not Included";
  }

  return String(
    value,
  );
};


const getFeatures = (
  features: unknown,
): string[] => {
  if (
    !features
  ) {
    return [];
  }

  if (
    Array.isArray(
      features,
    )
  ) {
    return features
      .flatMap(
        (
          feature,
        ) => {
          if (
            typeof feature ===
            "string"
          ) {
            return [
              formatFeatureName(
                feature,
              ),
            ];
          }

          if (
            feature &&
            typeof feature ===
            "object"
          ) {
            return Object.entries(
              feature as Record<
                string,
                unknown
              >,
            )
              .filter(
                (
                  [
                    ,
                    value,
                  ],
                ) =>
                  value === true ||
                  value === 1 ||
                  value === "true",
              )
              .map(
                (
                  [
                    key,
                  ],
                ) =>
                  formatFeatureName(
                    key,
                  ),
              );
          }

          return [];
        },
      )
      .filter(
        Boolean,
      );
  }

  if (
    typeof features ===
    "object"
  ) {
    return Object.entries(
      features as Record<
        string,
        unknown
      >,
    )
      .filter(
        (
          [
            ,
            value,
          ],
        ) =>
          value === true ||
          value === 1 ||
          value === "true",
      )
      .map(
        (
          [
            key,
          ],
        ) =>
          formatFeatureName(
            key,
          ),
      );
  }

  return [];
};


const getLimits = (
  limits: unknown,
): Array<{
  label: string;
  value: string;
}> => {
  if (
    !limits ||
    typeof limits !==
      "object" ||
    Array.isArray(
      limits,
    )
  ) {
    return [];
  }

  return Object.entries(
    limits as Record<
      string,
      unknown
    >,
  )
    .filter(
      (
        [
          ,
          value,
        ],
      ) =>
        value !== null &&
        value !== undefined,
    )
    .map(
      (
        [
          key,
          value,
        ],
      ) => ({
        label:
          limitLabels[
            key
          ] ??
          key
            .replace(
              /_/g,
              " ",
            )
            .replace(
              /\b\w/g,
              (
                character,
              ) =>
                character.toUpperCase(),
            ),

        value:
          formatLimitValue(
            key,
            value,
          ),
      }),
    );
};


export default function SubscriptionPlansPage() {
  const [
    plans,
    setPlans,
  ] =
    useState<
      SubscriptionPlan[]
    >([]);

  const [
    activeTab,
    setActiveTab,
  ] =
    useState<
      PlanTab
    >(
      "monthly",
    );

  const [
    loading,
    setLoading,
  ] =
    useState(
      true,
    );

  const [
    error,
    setError,
  ] =
    useState<
      string | null
    >(
      null,
    );


  const loadPlans =
    async () => {
      try {
        setLoading(
          true,
        );

        setError(
          null,
        );

        const result =
          await getSubscriptionPlans();

        setPlans(
          result.filter(
            (
              plan,
            ) =>
              plan.is_active,
          ),
        );
      } catch (
        err
      ) {
        setPlans(
          [],
        );

        setError(
          err instanceof Error
            ? err.message
            : "Unable to load subscription plans.",
        );
      } finally {
        setLoading(
          false,
        );
      }
    };


  useEffect(
    () => {
      void loadPlans();
    },
    [],
  );


  const visiblePlans =
    useMemo(
      () => {
        if (
          activeTab ===
          "addons"
        ) {
          return plans.filter(
            isAddonPlan,
          );
        }

        return plans.filter(
          (
            plan,
          ) =>
            !isAddonPlan(
              plan,
            ) &&
            plan.billing_cycle ===
              activeTab,
        );
      },
      [
        activeTab,
        plans,
      ],
    );


  return (
    <div className="min-h-full">
      <div className="mx-auto w-full max-w-7xl px-6 py-8 lg:px-10">
        <div className="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
          <div>
            <p className="text-sm font-medium text-muted-foreground">
              PhotoOS Subscription
            </p>

            <h1 className="mt-2 text-3xl font-bold tracking-tight">
              Subscription Plans
            </h1>

            <p className="mt-3 text-sm leading-6 text-muted-foreground">
              Choose the plan that fits your studio or
              extend your subscription with optional
              add-ons.
            </p>
          </div>

          <button
            type="button"
            onClick={
              () => {
                void loadPlans();
              }
            }
            disabled={
              loading
            }
            className="inline-flex items-center justify-center gap-2 rounded-xl border bg-background px-5 py-3 text-sm font-semibold transition-opacity hover:opacity-80 disabled:cursor-not-allowed disabled:opacity-60"
          >
            {loading ? (
              <Loader2 className="h-4 w-4 animate-spin" />
            ) : (
              <RefreshCw className="h-4 w-4" />
            )}

            Refresh Plans
          </button>
        </div>


        <div className="mt-8 inline-flex rounded-2xl border bg-muted/30 p-1">
          <button
            type="button"
            onClick={
              () =>
                setActiveTab(
                  "monthly",
                )
            }
            className={
              activeTab ===
              "monthly"
                ? "rounded-xl bg-white px-5 py-3 text-sm font-semibold shadow-sm"
                : "rounded-xl px-5 py-3 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
            }
          >
            Monthly
          </button>

          <button
            type="button"
            onClick={
              () =>
                setActiveTab(
                  "yearly",
                )
            }
            className={
              activeTab ===
              "yearly"
                ? "rounded-xl bg-white px-5 py-3 text-sm font-semibold shadow-sm"
                : "rounded-xl px-5 py-3 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
            }
          >
            Yearly
          </button>

          <button
            type="button"
            onClick={
              () =>
                setActiveTab(
                  "addons",
                )
            }
            className={
              activeTab ===
              "addons"
                ? "rounded-xl bg-[#0a3f61] px-5 py-3 text-sm font-semibold text-white shadow-sm"
                : "rounded-xl px-5 py-3 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
            }
          >
            Add-on Plans
          </button>
        </div>


        {loading && (
          <div className="mt-8 flex min-h-64 items-center justify-center rounded-2xl border bg-card">
            <div className="flex items-center gap-3 text-sm text-muted-foreground">
              <Loader2 className="h-5 w-5 animate-spin" />

              Loading subscription plans...
            </div>
          </div>
        )}


        {!loading &&
          error && (
            <div className="mt-8 rounded-2xl border bg-card p-6">
              <h2 className="font-semibold">
                Unable to load plans
              </h2>

              <p className="mt-2 text-sm text-muted-foreground">
                {error}
              </p>

              <button
                type="button"
