const formatFeatureName = (
  value: string,
) => {
  return value
    .replace(
      /_/g,
      " ",
    )
    .replace(
      /\b\w/g,
      (
        character,
      ) =>
        character.toUpperCase(),
    );
};


const formatValue = (
  value: unknown,
): string => {
  if (
    typeof value ===
    "boolean"
  ) {
    return value
      ? "Yes"
      : "No";
  }

  if (
    value === null ||
    value === undefined
  ) {
    return "—";
  }

  return String(
    value,
  );
};


