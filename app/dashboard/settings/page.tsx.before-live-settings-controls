  },

};


function getSettingValue(
  settings:
    WorkspaceSetting[],

  key:
    string,
):
  SettingValue {

  const setting =
    settings.find(
      (
        item,
      ) =>
        item.key ===
        key,
    );


  if (
    setting
  ) {

    return (
      setting.value ??
      {}
    );

  }


  return (
    DEFAULT_SETTINGS[
      key
    ] ??
    {}
  );

}


function formatDate(
  value:
    string,
) {

  try {

    return new Intl.DateTimeFormat(
      "en-IN",
      {
        day:
          "numeric",

        month:
          "long",

        year:
          "numeric",

        hour:
          "numeric",

        minute:
          "2-digit",
      },
    ).format(
      new Date(
        value,
      ),
    );

  } catch {

    return value;

  }

}


function getDisplaySchemaVersion(
  softwareUpdate:
    SoftwareUpdate,
) {

  const value =
    softwareUpdate.metadata[
      "display_schema_version"
    ];


  if (
    typeof value ===
    "string"
  ) {

    return value;

  }


  return (
    `PhotoOS-${
      String(
        softwareUpdate.schema_version,
      ).padStart(
        2,
        "0",
      )
    }`
  );

}


