  const [
    error,
    setError,
  ] =
    useState<
      string
      | null
    >(
      null,
    );


  const [
    workspaceSettings,
    setWorkspaceSettings,
  ] =
    useState<
      WorkspaceSetting[]
    >(
      [],
    );


  const [
    studioId,
    setStudioId,
  ] =
    useState<
      string
      | null
    >(
      null,
    );


  const [
    savingSetting,
    setSavingSetting,
  ] =
    useState<
      string
      | null
    >(
      null,
    );


  const [
    settingDrafts,
    setSettingDrafts,
  ] =
    useState<
      Record<
        string,
        Record<
          string,
          unknown
        >
      >
    >(
      {},
    );


  const [
    watermarkSettings,
    setWatermarkSettings,
  ] =
    useState<
      WatermarkSettings
    >(
      DEFAULT_WATERMARK_SETTINGS,
    );


  const [
    watermarkSaving,
    setWatermarkSaving,
  ] =
    useState(
      false,
    );


  const [
    watermarkUploadPreview,
    setWatermarkUploadPreview,
  ] =
    useState<
      string
      | null
    >(
      null,
    );


  const [
    showReleaseNotes,
    setShowReleaseNotes,
  ] =
    useState(
      false,
    );


  const loadWorkspaceSettings =
    useCallback(
      async () => {

        try {

          const membership =
            await resolveUserStudio();


          if (
            !membership
          ) {

            return;

          }


          setStudioId(
            membership.studioId,
          );


          const result =
            await getWorkspaceSettings(
              membership.studioId,
            );


          setWorkspaceSettings(
            result,
          );


          await loadWatermarkSettings(
            membership.studioId,
          );

        } catch (
          settingsError
        ) {

          console.error(
            "Unable to load workspace settings:",
            settingsError,
          );

        }

      },
      [],
    );


  const updateToggleSetting =
    useCallback(
      async (
        category:
          string,

        key:
          string,

        description:
          string,
      ) => {

        if (
          !studioId
        ) {

          return;

        }


        const currentValue =
          getSettingValue(
            workspaceSettings,
            key,
          );


        const nextValue = {
          ...currentValue,
          enabled:
            !Boolean(
              currentValue.enabled,
            ),
        };


        try {

          setSavingSetting(
            key,
          );


          await saveWorkspaceSetting(
            studioId,
            category,
            key,
            nextValue,
            description,
          );


          setWorkspaceSettings(
            (
              current,
            ) => {

              const existingIndex =
                current.findIndex(
                  (
                    item,
                  ) =>
                    item.key ===
                    key,
                );


              if (
                existingIndex ===
                -1
              ) {

                return current;

              }


              return current.map(
                (
                  item,
                ) =>
                  item.key ===
                  key
                    ? {
                        ...item,
                        value:
                          nextValue,
                      }
                    : item,
              );

            },
          );


          await loadWorkspaceSettings();

        } catch (
          saveError
        ) {

          console.error(
            "Unable to save workspace setting:",
            saveError,
          );

        } finally {

          setSavingSetting(
            null,
          );

        }

      },
      [
        studioId,
        workspaceSettings,
        loadWorkspaceSettings,
      ],
    );


  const loadWatermarkSettings =
    useCallback(
      async (
        targetStudioId:
          string,
      ) => {

        try {

          const result =
            await getWatermarkSettings(
              targetStudioId,
            );


          setWatermarkSettings(
            result,
          );


          if (
            result.source ===
            "upload"
            &&
            result.upload_url
          ) {

            setWatermarkUploadPreview(
              result.upload_url,
            );

          }

        } catch (
          watermarkError
        ) {

          console.error(
            "Unable to load watermark settings:",
            watermarkError,
          );

        }

      },
      [],
    );


  const persistWatermarkSettings =
    useCallback(
      async (
        nextSettings:
          WatermarkSettings,
      ) => {

        if (
          !studioId
        ) {

          return;

        }


        try {

          setWatermarkSaving(
            true,
          );


          await saveWatermarkSettings(
            studioId,
            nextSettings,
          );


          setWatermarkSettings(
            nextSettings,
          );

        } catch (
          watermarkSaveError
        ) {

          console.error(
            "Unable to save watermark settings:",
            watermarkSaveError,
          );

        } finally {

          setWatermarkSaving(
            false,
          );

        }

      },
      [
        studioId,
      ],
    );


  const handleWatermarkUpload =
    useCallback(
      async (
        event:
          React.ChangeEvent<
            HTMLInputElement
          >,
      ) => {

        const file =
          event.target.files?.[
            0
          ];


        if (
          !file
