function formatDate(
  value:
    string,
) {

  try {

    return new Intl.DateTimeFormat(
      "en-IN",
      {
        day:
          "numeric",

        month:
          "long",

        year:
          "numeric",

        hour:
          "numeric",

        minute:
          "2-digit",
      },
    ).format(
      new Date(
        value,
      ),
    );

  } catch {

    return value;

  }

}


function getDisplaySchemaVersion(
  softwareUpdate:
    SoftwareUpdate,
) {

  const value =
    softwareUpdate.metadata[
      "display_schema_version"
    ];


  if (
    typeof value ===
    "string"
  ) {

    return value;

  }


  return (
    `PhotoOS-${
      String(
        softwareUpdate.schema_version,
      ).padStart(
        2,
        "0",
      )
    }`
  );

}


export default function SettingsPage() {

  const [
    softwareUpdate,
    setSoftwareUpdate,
  ] =
    useState<
