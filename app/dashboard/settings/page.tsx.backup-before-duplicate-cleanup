  },

  public_workspace: {
    enabled: false,
  },

  team_member_access: {
    enabled: true,
  },

  new_member_approval: {
    enabled: true,
  },

  email_communications: {
    enabled: true,
  },

  session_protection: {
    enabled: true,
  },

  payment_notifications: {
    enabled: true,
  },

  ai_processing: {
    enabled: true,
  },

  automatic_processing: {
    enabled: false,
  },

  watermark_enabled: {
    enabled: false,
  },

  download_protection: {
    enabled: false,
  },

};


function getSettingValue(
  settings:
    WorkspaceSetting[],

  key:
    string,
):
  SettingValue {

  const setting =
    settings.find(
      (
        item,
      ) =>
        item.key ===
        key,
    );


  if (
    setting
  ) {

    return (
      setting.value ??
      {}
    );

  }


  return (
    DEFAULT_SETTINGS[
      key
    ] ??
    {}
  );

}


