          return;

        }


        const previewUrl =
          URL.createObjectURL(
            file,
          );


        setWatermarkUploadPreview(
          previewUrl,
        );


        const nextSettings = {
          ...watermarkSettings,

          enabled:
            true,

          source:
            "upload" as const,

          upload_url:
            previewUrl,

          upload_name:
            file.name,
        };


        await persistWatermarkSettings(
          nextSettings,
        );

      },
      [
        watermarkSettings,
        persistWatermarkSettings,
      ],
    );


  const getWorkspaceSetting =
    useCallback(
      (
        key:
          string,
      ) => {

        const saved =
          workspaceSettings.find(
            (
              item,
            ) =>
              item.key ===
              key,
          );


        return (
          settingDrafts[
            key
          ] ??
          saved?.value ??
          {}
        );

      },
      [
        workspaceSettings,
        settingDrafts,
      ],
    );


  const updateWorkspaceSettingValue =
    useCallback(
      (
        key:
          string,

        value:
          Record<
            string,
            unknown
          >,
      ) => {

        setSettingDrafts(
          (
            current,
          ) => (
            {
              ...current,

              [
                key
              ]:
                value,
            }
          ),
        );

      },
      [],
    );


  const persistWorkspaceSetting =
    useCallback(
      async (
        category:
          string,

        key:
          string,

        value:
          Record<
            string,
            unknown
          >,

        description:
          string,
      ) => {

        if (
          !studioId
        ) {

          return;

        }


        try {

          setSavingSetting(
            key,
          );


          await saveWorkspaceSetting(
            studioId,
            category,
            key,
            value,
            description,
          );


          setWorkspaceSettings(
            (
              current,
            ) => {

              const existing =
                current.find(
                  (
                    item,
                  ) =>
                    item.key ===
                    key,
                );


              if (
                existing
              ) {

                return current.map(
                  (
                    item,
                  ) =>
                    item.key ===
                    key
                      ? {
                          ...item,

                          category,

                          value,
                          description,
                        }
                      : item,
                );

              }


              return [
                ...current,
                {
                  id:
                    crypto.randomUUID(),

                  studio_id:
                    studioId,

                  category,

                  key,

                  value,

                  description,

                  is_active:
                    true,

                  created_at:
                    new Date().toISOString(),

                  updated_at:
                    new Date().toISOString(),
                },
              ];

            },
          );


          setSettingDrafts(
            (
              current,
            ) => {

              const next =
                {
                  ...current,
                };


              delete next[
                key
              ];


              return next;

            },
          );

        } catch (
          saveError
        ) {

          console.error(
            "Unable to save workspace setting:",
            saveError,
          );

        } finally {

          setSavingSetting(
            null,
          );

        }

      },
      [
        studioId,
      ],
    );


  const toggleWorkspaceSetting =
    useCallback(
      async (
        category:
          string,

        key:
          string,

        description:
          string,

        defaultEnabled:
          boolean =
            false,
      ) => {

        const current =
          getWorkspaceSetting(
            key,
          );


        const currentEnabled =
          typeof current.enabled ===
          "boolean"
            ? current.enabled
            : defaultEnabled;


        const next =
          {
            ...current,

            enabled:
              !currentEnabled,
          };


        updateWorkspaceSettingValue(
          key,
          next,
        );


        await persistWorkspaceSetting(
          category,
          key,
          next,
          description,
        );

      },
      [
        getWorkspaceSetting,
        updateWorkspaceSettingValue,
        persistWorkspaceSetting,
      ],
    );



