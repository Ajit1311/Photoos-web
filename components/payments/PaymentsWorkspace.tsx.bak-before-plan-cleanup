"use client";

import {
  useCallback,
  useEffect,
  useMemo,
  useState,
} from "react";

import {
  Banknote,
  CheckCircle2,
  CreditCard,
  IndianRupee,
  Loader2,
  Plus,
  RefreshCw,
  RotateCcw,
  Search,
  WalletCards,
  X,
} from "lucide-react";

import {
  createPaymentRefund,
  getPaymentRefunds,
  getPayments,
} from "@/lib/api/payments";

import {
  useSubscriptionAccess,
} from "@/context/SubscriptionAccessContext";

import {
  getSubscriptionPlans,
} from "@/lib/api/subscription/plans";

import type {
  SubscriptionPlan,
} from "@/types/subscription/plan";

import type {
  PaymentGateway,
  PaymentMethod,
  PaymentTransaction,
  PaymentRefund,
} from "@/types/payment";

type PaymentFilter =
  | "all"
  | "completed"
  | "pending"
  | "failed"
  | "refunded";

type RefundFormState = {
  amount: string;
  reason: string;
  notes: string;
  refundMethod: PaymentMethod;
  gateway: PaymentGateway;
};

const initialRefundForm: RefundFormState = {
  amount: "",
  reason: "",
  notes: "",
  refundMethod: "upi",
  gateway: "manual",
};

function formatCurrency(
  amount: number,
  currency = "INR",
): string {
  return new Intl.NumberFormat(
    "en-IN",
    {
      style: "currency",
      currency,
      maximumFractionDigits: 2,
    },
  ).format(
    amount,
  );
}

function formatDate(
  value: string | null,
): string {
  if (!value) {
    return "—";
  }

  const date =
    new Date(value);

  if (
    Number.isNaN(
      date.getTime(),
    )
  ) {
    return "—";
  }

  return new Intl.DateTimeFormat(
    "en-IN",
    {
      day: "2-digit",
      month: "short",
      year: "numeric",
    },
  ).format(
    date,
  );
}

function getStatusClass(
  status: string,
): string {
  const normalized =
    status.toLowerCase();

  if (
    normalized === "completed" ||
    normalized === "success"
  ) {
    return "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400";
  }

  if (
    normalized === "pending" ||
    normalized === "processing"
  ) {
    return "bg-amber-500/10 text-amber-600 dark:text-amber-400";
  }

  if (
    normalized === "failed" ||
    normalized === "cancelled"
  ) {
    return "bg-red-500/10 text-red-600 dark:text-red-400";
  }

  if (
    normalized === "refunded"
  ) {
    return "bg-blue-500/10 text-blue-600 dark:text-blue-400";
  }

  return "bg-muted text-muted-foreground";
}

function getMethodLabel(
  method: string,
): string {
  const labels: Record<
    string,
    string
  > = {
    cash: "Cash",
    upi: "UPI",
    net_banking: "Net Banking",
    debit_card: "Debit Card",
    credit_card: "Credit Card",
    phonepe: "PhonePe",
    google_pay: "Google Pay",
    paytm: "Paytm",
    bank_transfer: "Bank Transfer",
    other: "Other",
  };

  return (
    labels[method] ??
    method
      .replaceAll(
        "_",
        " ",
      )
      .replace(
        /\b\w/g,
        (
          character,
        ) =>
          character.toUpperCase(),
      )
  );
}

export function PaymentsWorkspace() {

  const {
    data: subscriptionAccess,
    loading: subscriptionLoading,
  } =
    useSubscriptionAccess();


  const [
    subscriptionPlans,
    setSubscriptionPlans,
  ] =
    useState<
      SubscriptionPlan[]
    >(
      [],
    );


  const [
    plansLoading,
    setPlansLoading,
  ] =
    useState(
      true,
    );


  const [
    plansError,
    setPlansError,
  ] =
    useState<
      string | null
    >(
      null,
    );


  const [
    payments,
    setPayments,
  ] = useState<
    PaymentTransaction[]
  >([]);

  const [
    refunds,
    setRefunds,
  ] = useState<
    PaymentRefund[]
  >([]);

  const [
    loading,
    setLoading,
  ] = useState(
    true,
  );

  const [
    refreshing,
    setRefreshing,
  ] = useState(
    false,
  );

  const [
    error,
    setError,
  ] = useState<
    string | null
  >(null);

  const [
    search,
    setSearch,
  ] = useState(
    "",
  );

  const [
    statusFilter,
    setStatusFilter,
  ] = useState<
    PaymentFilter
  >("all");

  const [
    refundModalOpen,
    setRefundModalOpen,
  ] = useState(
    false,
  );

  const [
    selectedPayment,
    setSelectedPayment,
  ] = useState<
    PaymentTransaction | null
  >(null);

  const [
    refundForm,
    setRefundForm,
  ] = useState<
    RefundFormState
  >(initialRefundForm);

  const [
    refundSubmitting,
    setRefundSubmitting,
  ] = useState(
    false,
  );

  const [
    refundError,
    setRefundError,
  ] = useState<
    string | null
  >(null);

  const loadData =
    useCallback(
      async (
        showRefreshing = false,
      ) => {
        try {
          setError(
            null,
          );

          if (
            showRefreshing
          ) {
            setRefreshing(
              true,
            );
          } else {
            setLoading(
              true,
            );
          }

          const [
            paymentData,
            refundData,
          ] =
            await Promise.all([
              getPayments(),
              getPaymentRefunds(),
            ]);

          setPayments(
            paymentData,
          );

          setRefunds(
            refundData,
          );
        } catch (
          loadError
        ) {
          setError(
            loadError instanceof Error
              ? loadError.message
              : "Unable to load payment data.",
          );
        } finally {
          setLoading(
            false,
          );

          setRefreshing(
            false,
          );
        }
      },
      [],
    );

  useEffect(
    () => {
      void loadData();
    },
    [
      loadData,
    ],
  );


  useEffect(
    () => {

      let active =
        true;


      async function loadSubscriptionPlans() {

        try {

          setPlansLoading(
            true,
          );

          setPlansError(
            null,
          );


          const plans =
            await getSubscriptionPlans();


          if (active) {

            setSubscriptionPlans(
              plans,
            );

          }

        } catch (
          loadError
        ) {

          if (active) {

            setPlansError(
              loadError instanceof Error
                ? loadError.message
                : "Unable to load subscription plans.",
            );

          }

        } finally {

          if (active) {

            setPlansLoading(
              false,
            );

          }

        }

      }


      void loadSubscriptionPlans();


      return () => {

        active =
          false;

      };

    },
    [],
  );

  const filteredPayments =
    useMemo(
      () => {
        const query =
          search
            .trim()
            .toLowerCase();

        return payments.filter(
          (
            payment,
          ) => {
            const matchesStatus =
              statusFilter ===
                "all" ||
              payment.status
                .toLowerCase() ===
                statusFilter;

            if (
              !matchesStatus
            ) {
              return false;
            }

            if (!query) {
              return true;
            }

            const searchable =
              [
                payment.paymentNumber.toString(),
                payment.status,
                payment.method,
                payment.transactionId ??
                  "",
                payment.notes ??
                  "",
              ]
                .join(
                  " ",
                )
                .toLowerCase();

            return searchable.includes(
              query,
            );
          },
        );
      },
      [
        payments,
        search,
        statusFilter,
      ],
    );

  const totalCollected =
    useMemo(
      () =>
        payments
          .filter(
            (
              payment,
            ) =>
              payment.paymentMode ===
                "incoming" &&
              [
                "completed",
                "success",
              ].includes(
                payment.status.toLowerCase(),
              ),
          )
          .reduce(
            (
              total,
              payment,
            ) =>
              total +
              payment.totalAmount,
            0,
          ),
      [
        payments,
      ],
    );

  const totalRefunded =
    useMemo(
      () =>
        refunds
          .filter(
            (
              refund,
            ) =>
              [
                "completed",
                "processing",
                "pending",
              ].includes(
                refund.status.toLowerCase(),
              ),
          )
          .reduce(
            (
              total,
              refund,
            ) =>
              total +
              refund.amount,
            0,
          ),
      [
        refunds,
      ],
    );

  const pendingAmount =
    useMemo(
      () =>
        payments
          .filter(
            (
              payment,
            ) =>
              payment.status
                .toLowerCase() ===
              "pending",
          )
          .reduce(
            (
              total,
              payment,
            ) =>
              total +
              payment.totalAmount,
            0,
          ),
      [
        payments,
      ],
    );

  const openRefundModal =
    (
      payment: PaymentTransaction,
    ) => {
      setSelectedPayment(
        payment,
      );

      setRefundForm({
        ...initialRefundForm,
        amount:
          payment.totalAmount.toString(),
      });

      setRefundError(
        null,
      );

      setRefundModalOpen(
        true,
      );
    };

  const closeRefundModal =
    () => {
      if (
        refundSubmitting
      ) {
        return;
      }

      setRefundModalOpen(
        false,
      );

      setSelectedPayment(
        null,
      );

      setRefundForm(
        initialRefundForm,
      );

      setRefundError(
        null,
      );
    };

  const handleRefundSubmit =
    async (
      event: React.FormEvent<
        HTMLFormElement
      >,
    ) => {
      event.preventDefault();

      if (
        !selectedPayment
      ) {
        return;
      }

      try {
        setRefundSubmitting(
          true,
        );

        setRefundError(
          null,
        );

        const refundAmount =
          Number(
            refundForm.amount,
          );

        if (
          !Number.isFinite(
            refundAmount,
          ) ||
          refundAmount <= 0
        ) {
          throw new Error(
            "Enter a valid refund amount.",
          );
        }

        if (
          refundAmount >
          selectedPayment.totalAmount
        ) {
          throw new Error(
            "Refund amount cannot be greater than the payment amount.",
          );
        }

        const createdRefund =
          await createPaymentRefund({
            paymentId:
              selectedPayment.id,
            amount:
              refundAmount,
            reason:
              refundForm.reason,
            notes:
              refundForm.notes,
            refundMethod:
              refundForm.refundMethod,
            gateway:
              refundForm.gateway,
          });

        setRefunds(
          (
            current,
          ) => [
            createdRefund,
            ...current,
          ],
        );

        closeRefundModal();

        await loadData(
          true,
        );
      } catch (
        submitError
      ) {
        setRefundError(
          submitError instanceof Error
            ? submitError.message
            : "Unable to create refund.",
        );
      } finally {
        setRefundSubmitting(
          false,
        );
      }
    };

  if (
    loading
  ) {
    return (
      <div className="flex min-h-[400px] items-center justify-center">
        <div className="flex items-center gap-3 text-sm text-muted-foreground">
          <Loader2 className="h-5 w-5 animate-spin" />
          Loading payment data...
        </div>
      </div>
    );
  }

  return (
    <>
      <div className="space-y-6">

        <section className="rounded-2xl border bg-card p-6 shadow-sm">

          <div className="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">

            <div>

              <p className="text-sm font-medium text-muted-foreground">
                Current Subscription
              </p>

              <div className="mt-2 flex flex-wrap items-center gap-3">

                <h2 className="text-2xl font-semibold tracking-tight">

                  {
                    subscriptionLoading
                      ? "Loading plan..."
                      : subscriptionAccess?.plan_name ??
                        "No active plan"
                  }

                </h2>


                {
                  subscriptionAccess?.has_access
                    ? (
                        <span className="rounded-full bg-emerald-500/10 px-3 py-1 text-xs font-medium text-emerald-600 dark:text-emerald-400">
                          Active
                        </span>
                      )
                    : (
                        <span className="rounded-full bg-destructive/10 px-3 py-1 text-xs font-medium text-destructive">
                          Inactive
                        </span>
                      )
                }

              </div>


              <p className="mt-3 text-sm text-muted-foreground">

                {
                  subscriptionAccess?.is_trial
                    ? "You are currently using a free trial."
                    : subscriptionAccess?.subscription_end_at
                      ? `Current access ends on ${formatDate(
                          subscriptionAccess.subscription_end_at,
                        )}.`
                      : "Manage your PhotoOS subscription and billing."
                }

              </p>

            </div>


            <button
              type="button"
              onClick={() => {

                document
                  .getElementById(
                    "subscription-plans",
                  )
                  ?.scrollIntoView(
                    {
                      behavior: "smooth",
                    },
                  );

              }}
              className="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground"
            >

              <CreditCard className="h-4 w-4" />

              Change Plan

            </button>

          </div>

        </section>


        <section
          id="subscription-plans"
          className="space-y-4"
        >

          <div>

            <h2 className="text-xl font-semibold">
              Available Plans
            </h2>

            <p className="mt-1 text-sm text-muted-foreground">
              Choose the PhotoOS plan that fits your studio.
            </p>

          </div>


          {
            plansLoading
              ? (
                  <div className="flex min-h-[180px] items-center justify-center rounded-2xl border">

                    <div className="flex items-center gap-3 text-sm text-muted-foreground">

                      <Loader2 className="h-5 w-5 animate-spin" />

                      Loading subscription plans...

                    </div>

                  </div>
                )
              : subscriptionPlans.length === 0
                ? (
                    <div className="rounded-2xl border p-6 text-sm text-muted-foreground">

                      No subscription plans are available right now.

                    </div>
                  )
                : (
                    <div className="grid gap-5 lg:grid-cols-3">

                      {
                        subscriptionPlans.map(
                          (
                            plan,
                          ) => {

                            const isCurrentPlan =
                              subscriptionAccess?.plan ===
                              plan.plan_code;


                            return (
                              <div
                                key={
                                  plan.id
                                }
                                className={`flex flex-col rounded-2xl border p-6 ${
                                  isCurrentPlan
                                    ? "border-primary ring-1 ring-primary/30"
                                    : ""
                                }`}
                              >

                                <div className="flex items-start justify-between gap-4">

                                  <div>

                                    <h3 className="text-lg font-semibold">

                                      {
                                        plan.name
                                      }

                                    </h3>


                                    {
                                      plan.description
                                        ? (
                                            <p className="mt-2 text-sm leading-6 text-muted-foreground">

                                              {
                                                plan.description
                                              }

                                            </p>
                                          )
                                        : null
                                    }

                                  </div>


                                  {
                                    isCurrentPlan
                                      ? (
                                          <span className="shrink-0 rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary">

                                            Current Plan

                                          </span>
                                        )
                                      : null
                                  }

                                </div>


                                <div className="mt-6">

                                  <div className="flex items-baseline gap-2">

                                    <span className="text-3xl font-semibold">

                                      {
                                        formatCurrency(
                                          plan.price,
                                          plan.currency,
                                        )
                                      }

                                    </span>


                                    <span className="text-sm text-muted-foreground">

                                      /
                                      {
                                        plan.billing_cycle
                                      }

                                    </span>

                                  </div>


                                  {
                                    plan.trial_days > 0
                                      ? (
                                          <p className="mt-2 text-sm text-muted-foreground">

                                            {
                                              plan.trial_days
                                            }
                                            {" "}
                                            day free trial

                                          </p>
                                        )
                                      : null
                                  }

                                </div>


                                <div className="mt-6 flex-1 space-y-3">

                                  {
                                    Object.entries(
                                      plan.features ?? {},
                                    )
                                      .filter(
                                        (
                                          [
                                            ,
                                            value,
                                          ],
                                        ) =>
                                          value ===
                                          true,
                                      )
                                      .slice(
                                        0,
                                        6,
                                      )
                                      .map(
                                        (
                                          [
                                            key,
                                          ],
                                        ) => (
                                          <div
                                            key={key}
                                            className="flex items-center gap-2 text-sm"
                                          >

                                            <CheckCircle2 className="h-4 w-4 shrink-0 text-emerald-600 dark:text-emerald-400" />

                                            {
                                              key
                                                .replaceAll(
                                                  "_",
                                                  " ",
                                                )
                                                .replace(
                                                  /\b\w/g,
                                                  (
                                                    character,
                                                  ) =>
                                                    character.toUpperCase(),
                                                )
                                            }

                                          </div>
                                        ),
                                      )
                                  }

                                </div>


                                <button
                                  type="button"
                                  disabled={
                                    isCurrentPlan
                                  }
                                  className="mt-8 inline-flex w-full items-center justify-center rounded-lg border px-4 py-2.5 text-sm font-medium transition hover:bg-muted disabled:cursor-default disabled:opacity-60"
                                >

                                  {
                                    isCurrentPlan
                                      ? "Current Plan"
                                      : "Choose Plan"
                                  }

                                </button>

                              </div>
                            );

                          },
                        )
                      }

                    </div>
                  )
          }

        </section>
        <div className="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
          <div>
            <h1 className="text-2xl font-semibold tracking-tight">
              Payments
            </h1>

            <p className="mt-1 text-sm text-muted-foreground">
              Track transactions, payment activity, and refunds.
            </p>
          </div>

          <button
            type="button"
            onClick={() =>
              void loadData(
                true,
              )
            }
            disabled={
              refreshing
            }
            className="inline-flex items-center justify-center gap-2 rounded-lg border px-4 py-2 text-sm font-medium transition hover:bg-muted disabled:cursor-not-allowed disabled:opacity-60"
          >
            <RefreshCw
              className={`h-4 w-4 ${
                refreshing
                  ? "animate-spin"
                  : ""
              }`}
            />

            Refresh
          </button>
        </div>

        {error ? (
          <div className="rounded-xl border border-red-500/30 bg-red-500/10 p-4 text-sm text-red-600 dark:text-red-400">
            <div className="flex items-start justify-between gap-4">
              <div>
                <p className="font-medium">
                  Unable to load payment data
                </p>

                <p className="mt-1">
                  {error}
                </p>
              </div>

              <button
                type="button"
                onClick={() =>
                  void loadData(
                    true,
                  )
                }
                className="shrink-0 rounded-md border border-red-500/30 px-3 py-1.5 text-xs font-medium"
              >
                Retry
              </button>
            </div>
          </div>
        ) : null}

        <div className="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
          <div className="rounded-xl border bg-card p-5">
            <div className="flex items-center justify-between">
              <span className="text-sm text-muted-foreground">
                Total Collected
              </span>

              <IndianRupee className="h-5 w-5 text-muted-foreground" />
            </div>

            <p className="mt-3 text-2xl font-semibold">
              {formatCurrency(
                totalCollected,
              )}
            </p>
          </div>

          <div className="rounded-xl border bg-card p-5">
            <div className="flex items-center justify-between">
              <span className="text-sm text-muted-foreground">
                Pending
              </span>

              <WalletCards className="h-5 w-5 text-muted-foreground" />
            </div>

            <p className="mt-3 text-2xl font-semibold">
              {formatCurrency(
                pendingAmount,
              )}
            </p>
          </div>

          <div className="rounded-xl border bg-card p-5">
            <div className="flex items-center justify-between">
              <span className="text-sm text-muted-foreground">
                Refunded
              </span>

              <RotateCcw className="h-5 w-5 text-muted-foreground" />
            </div>

            <p className="mt-3 text-2xl font-semibold">
              {formatCurrency(
                totalRefunded,
              )}
            </p>
          </div>

          <div className="rounded-xl border bg-card p-5">
            <div className="flex items-center justify-between">
              <span className="text-sm text-muted-foreground">
                Transactions
              </span>

              <CreditCard className="h-5 w-5 text-muted-foreground" />
            </div>

            <p className="mt-3 text-2xl font-semibold">
              {payments.length}
            </p>
          </div>
        </div>

        <div className="rounded-xl border bg-card">
          <div className="flex flex-col gap-4 border-b p-4 lg:flex-row lg:items-center lg:justify-between">
            <div className="relative w-full lg:max-w-md">
              <Search className="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />

              <input
                value={search}
                onChange={(
                  event,
                ) =>
                  setSearch(
                    event.target.value,
                  )
                }
                placeholder="Search transactions..."
                className="h-10 w-full rounded-lg border bg-background pl-9 pr-3 text-sm outline-none focus:ring-2 focus:ring-primary/20"
              />
            </div>

            <div className="flex flex-wrap gap-2">
              {[
                "all",
                "completed",
                "pending",
                "failed",
                "refunded",
              ].map(
                (
                  status,
                ) => (
                  <button
                    key={status}
                    type="button"
                    onClick={() =>
                      setStatusFilter(
                        status as PaymentFilter,
                      )
                    }
                    className={`rounded-lg px-3 py-2 text-xs font-medium capitalize transition ${
                      statusFilter ===
                      status
                        ? "bg-primary text-primary-foreground"
                        : "border hover:bg-muted"
                    }`}
                  >
                    {status}
                  </button>
                ),
              )}
            </div>
          </div>

          <div className="overflow-x-auto">
            <table className="w-full min-w-[900px]">
              <thead>
                <tr className="border-b text-left text-xs uppercase tracking-wide text-muted-foreground">
                  <th className="px-5 py-3 font-medium">
                    Transaction
                  </th>

                  <th className="px-5 py-3 font-medium">
                    Method
                  </th>

                  <th className="px-5 py-3 font-medium">
                    Amount
                  </th>

                  <th className="px-5 py-3 font-medium">
                    Date
                  </th>

                  <th className="px-5 py-3 font-medium">
                    Status
                  </th>

                  <th className="px-5 py-3 text-right font-medium">
                    Action
                  </th>
                </tr>
              </thead>

              <tbody>
                {filteredPayments.map(
                  (
                    payment,
                  ) => (
                    <tr
                      key={
                        payment.id
                      }
                      className="border-b last:border-b-0"
                    >
                      <td className="px-5 py-4">
                        <div className="font-medium">
                          #
                          {
                            payment.paymentNumber
                          }
                        </div>

                        <div className="mt-1 max-w-[220px] truncate text-xs text-muted-foreground">
                          {
                            payment.transactionId ??
                              payment.notes ??
                              "No transaction reference"
                          }
                        </div>
                      </td>

                      <td className="px-5 py-4 text-sm">
                        <div className="flex items-center gap-2">
                          <Banknote className="h-4 w-4 text-muted-foreground" />

                          {
                            getMethodLabel(
                              payment.method,
                            )
                          }
                        </div>
                      </td>

                      <td className="px-5 py-4 font-medium">
                        {
                          formatCurrency(
                            payment.totalAmount,
                            payment.currency,
                          )
                        }
                      </td>

                      <td className="px-5 py-4 text-sm text-muted-foreground">
                        {
                          formatDate(
                            payment.paymentDate ??
                              payment.createdAt,
                          )
                        }
                      </td>

                      <td className="px-5 py-4">
                        <span
                          className={`inline-flex rounded-full px-2.5 py-1 text-xs font-medium capitalize ${getStatusClass(
                            payment.status,
                          )}`}
                        >
                          {
                            payment.status.replaceAll(
                              "_",
                              " ",
                            )
                          }
                        </span>
                      </td>

                      <td className="px-5 py-4 text-right">
                        <button
                          type="button"
                          onClick={() =>
                            openRefundModal(
                              payment,
                            )
                          }
                          disabled={
                            payment.status
                              .toLowerCase() ===
                            "refunded"
                          }
                          className="inline-flex items-center gap-2 rounded-lg border px-3 py-2 text-xs font-medium transition hover:bg-muted disabled:cursor-not-allowed disabled:opacity-40"
                        >
                          <RotateCcw className="h-3.5 w-3.5" />

                          Refund
                        </button>
                      </td>
                    </tr>
                  ),
                )}

                {filteredPayments.length ===
                0 ? (
                  <tr>
                    <td
                      colSpan={6}
                      className="px-5 py-16 text-center text-sm text-muted-foreground"
                    >
                      No payment transactions found.
                    </td>
                  </tr>
                ) : null}
              </tbody>
            </table>
          </div>
        </div>

        <div className="rounded-xl border bg-card">
          <div className="flex items-center justify-between border-b p-5">
            <div>
              <h2 className="font-semibold">
                Refund History
              </h2>

              <p className="mt-1 text-sm text-muted-foreground">
                All refund requests and processed refunds.
              </p>
            </div>

            <RotateCcw className="h-5 w-5 text-muted-foreground" />
          </div>

          <div className="overflow-x-auto">
            <table className="w-full min-w-[850px]">
              <thead>
                <tr className="border-b text-left text-xs uppercase tracking-wide text-muted-foreground">
                  <th className="px-5 py-3 font-medium">
                    Refund
                  </th>

                  <th className="px-5 py-3 font-medium">
                    Reason
                  </th>

                  <th className="px-5 py-3 font-medium">
                    Method
                  </th>

                  <th className="px-5 py-3 font-medium">
                    Amount
                  </th>

                  <th className="px-5 py-3 font-medium">
                    Status
                  </th>

                  <th className="px-5 py-3 font-medium">
                    Date
                  </th>
                </tr>
              </thead>

              <tbody>
                {refunds.map(
                  (
                    refund,
                  ) => (
                    <tr
                      key={
                        refund.id
                      }
                      className="border-b last:border-b-0"
                    >
                      <td className="px-5 py-4">
                        <div className="font-medium">
                          {
                            refund.id.slice(
                              0,
                              8,
                              )
                          }
                        </div>

                        <div className="mt-1 text-xs text-muted-foreground">
                          Payment{" "}
                          {
                            refund.paymentId.slice(
                              0,
                              8,
                            )
                          }
                        </div>
                      </td>

                      <td className="px-5 py-4">
                        <div className="max-w-[260px] text-sm">
                          {
                            refund.reason
                          }
                        </div>

                        {refund.notes ? (
                          <div className="mt-1 max-w-[260px] truncate text-xs text-muted-foreground">
                            {
                              refund.notes
                            }
                          </div>
                        ) : null}
                      </td>

                      <td className="px-5 py-4 text-sm">
                        {
                          refund.paymentMethod
                            ? getMethodLabel(
                                refund.paymentMethod,
                              )
                            : "—"
                        }
                      </td>

                      <td className="px-5 py-4 font-medium">
                        {
                          formatCurrency(
                            refund.amount,
                            refund.currency,
                          )
                        }
                      </td>

                      <td className="px-5 py-4">
                        <span
                          className={`inline-flex rounded-full px-2.5 py-1 text-xs font-medium capitalize ${getStatusClass(
                            refund.status,
                          )}`}
                        >
                          {
                            refund.status.replaceAll(
                              "_",
                              " ",
                            )
                          }
                        </span>
                      </td>

                      <td className="px-5 py-4 text-sm text-muted-foreground">
                        {
                          formatDate(
                            refund.createdAt,
                          )
                        }
                      </td>
                    </tr>
                  ),
                )}

                {refunds.length ===
                0 ? (
                  <tr>
                    <td
                      colSpan={6}
                      className="px-5 py-16 text-center text-sm text-muted-foreground"
                    >
                      No refunds created yet.
                    </td>
                  </tr>
                ) : null}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      {refundModalOpen &&
      selectedPayment ? (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
          <div className="max-h-[90vh] w-full max-w-lg overflow-y-auto rounded-2xl border bg-background shadow-xl">
            <div className="flex items-start justify-between border-b p-5">
              <div>
                <h2 className="text-lg font-semibold">
                  Create Refund
                </h2>

                <p className="mt-1 text-sm text-muted-foreground">
                  Payment #
                  {
                    selectedPayment.paymentNumber
                  } ·{" "}
                  {
                    formatCurrency(
                      selectedPayment.totalAmount,
                      selectedPayment.currency,
                    )
                  }
                </p>
              </div>

              <button
                type="button"
                onClick={
                  closeRefundModal
                }
                disabled={
                  refundSubmitting
                }
                className="rounded-lg p-2 hover:bg-muted disabled:opacity-50"
                aria-label="Close"
              >
                <X className="h-5 w-5" />
              </button>
            </div>

            <form
              onSubmit={
                handleRefundSubmit
              }
              className="space-y-5 p-5"
            >
              {refundError ? (
                <div className="rounded-lg border border-red-500/30 bg-red-500/10 p-3 text-sm text-red-600 dark:text-red-400">
                  {
                    refundError
                  }
                </div>
              ) : null}

              <div className="space-y-2">
                <label className="text-sm font-medium">
                  Refund Amount
                </label>

                <input
                  type="number"
                  min="0.01"
                  max={
                    selectedPayment.totalAmount
                  }
                  step="0.01"
                  value={
                    refundForm.amount
                  }
                  onChange={(
                    event,
                  ) =>
                    setRefundForm(
                      (
                        current,
                      ) => ({
                        ...current,
                        amount:
                          event.target.value,
                      }),
                    )
                  }
                  required
                  className="h-11 w-full rounded-lg border bg-background px-3 text-sm outline-none focus:ring-2 focus:ring-primary/20"
                />
              </div>

              <div className="space-y-2">
                <label className="text-sm font-medium">
                  Refund Reason
                </label>

                <textarea
                  value={
                    refundForm.reason
                  }
                  onChange={(
                    event,
                  ) =>
                    setRefundForm(
                      (
                        current,
                      ) => ({
                        ...current,
                        reason:
                          event.target.value,
                      }),
                    )
                  }
                  required
                  rows={3}
                  placeholder="Explain why this refund is being issued..."
                  className="w-full rounded-lg border bg-background px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-primary/20"
                />
              </div>

              <div className="space-y-2">
                <label className="text-sm font-medium">
                  Payment Method
                </label>

                <select
                  value={
                    refundForm.refundMethod
                  }
                  onChange={(
                    event,
                  ) =>
                    setRefundForm(
                      (
                        current,
                      ) => ({
                        ...current,
                        refundMethod:
                          event.target.value as PaymentMethod,
                      }),
                    )
                  }
                  className="h-11 w-full rounded-lg border bg-background px-3 text-sm outline-none focus:ring-2 focus:ring-primary/20"
                >
                  <option value="upi">
                    UPI
                  </option>

                  <option value="phonepe">
                    PhonePe
                  </option>

                  <option value="google_pay">
                    Google Pay
                  </option>

                  <option value="paytm">
                    Paytm
                  </option>

                  <option value="net_banking">
                    Net Banking
                  </option>

                  <option value="debit_card">
                    Debit Card
                  </option>

                  <option value="credit_card">
                    Credit Card
                  </option>

                  <option value="bank_transfer">
                    Bank Transfer
                  </option>

                  <option value="cash">
                    Cash
                  </option>
                </select>
              </div>

              <div className="space-y-2">
                <label className="text-sm font-medium">
                  Gateway
                </label>

                <select
                  value={
                    refundForm.gateway
                  }
                  onChange={(
                    event,
                  ) =>
                    setRefundForm(
                      (
                        current,
                      ) => ({
                        ...current,
                        gateway: event.target.value as PaymentGateway,
                      }),
                    )
                  }
                  className="h-11 w-full rounded-lg border bg-background px-3 text-sm outline-none focus:ring-2 focus:ring-primary/20"
                >
                  <option value="manual">
                    Manual Processing
                  </option>

                  <option value="phonepe">
                    PhonePe
                  </option>

                  <option value="razorpay">
                    Razorpay
                  </option>

                  <option value="cashfree">
                    Cashfree
                  </option>

                  <option value="paytm">
                    Paytm
                  </option>
                </select>

                <p className="text-xs text-muted-foreground">
                  Gateway integration can be activated later.
                </p>
              </div>

              <div className="space-y-2">
                <label className="text-sm font-medium">
                  Additional Notes
                </label>

                <textarea
                  value={
                    refundForm.notes
                  }
                  onChange={(
                    event,
                  ) =>
                    setRefundForm(
                      (
                        current,
                      ) => ({
                        ...current,
                        notes:
                          event.target.value,
                      }),
                    )
                  }
                  rows={3}
                  placeholder="Optional internal notes..."
                  className="w-full rounded-lg border bg-background px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-primary/20"
                />
              </div>

              <div className="flex items-center justify-end gap-3 border-t pt-5">
                <button
                  type="button"
                  onClick={
                    closeRefundModal
                  }
                  disabled={
                    refundSubmitting
                  }
                  className="rounded-lg border px-4 py-2.5 text-sm font-medium hover:bg-muted disabled:opacity-50"
                >
                  Cancel
                </button>

                <button
                  type="submit"
                  disabled={
                    refundSubmitting
                  }
                  className="inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground disabled:cursor-not-allowed disabled:opacity-60"
                >
                  {refundSubmitting ? (
                    <Loader2 className="h-4 w-4 animate-spin" />
                  ) : (
                    <CheckCircle2 className="h-4 w-4" />
                  )}

                  {
                    refundSubmitting
                      ? "Creating Refund..."
                      : "Create Refund"
                  }
                </button>
              </div>
            </form>
          </div>
        </div>
      ) : null}
    </>
  );
}