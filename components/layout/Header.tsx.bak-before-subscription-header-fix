"use client";

import {
  useEffect,
  useState,
} from "react";

import {
  Bell,
  Building2,
  Crown,
  Loader2,
} from "lucide-react";

import {
  useBootstrapContext,
} from "@/context/BootstrapContext";

import {
  useSubscriptionAccess,
} from "@/context/SubscriptionAccessContext";

import {
  useNotificationContext,
} from "@/context/NotificationContext";

import {
  getMarketplaceVerifiedAddon,
} from "@/lib/api/subscription/marketplace-verified-addon";

import NotificationPanel from "@/components/notifications/NotificationPanel";

import type {
  MarketplaceVerifiedAddonDetails,
} from "@/types/subscription/subscription";

import Breadcrumb from "./Breadcrumb";
import PageHeader from "./PageHeader";
import GlobalSearch from "./GlobalSearch";
import UserProfile from "./UserProfile";


export default function Header() {

  const bootstrap =
    useBootstrapContext();


  const {
    data: subscription,
    loading: subscriptionLoading,
  } =
    useSubscriptionAccess();


  const {
    badge: notificationBadge,
    chatUnread,
    loading: notificationLoading,
  } =
    useNotificationContext();


  const totalUnread =
    notificationBadge.unread +
    chatUnread;


  const studio =
    bootstrap.data?.workspace.studio ??
    null;


  const [
    notificationOpen,
    setNotificationOpen,
  ] =
    useState(
      false,
    );


  const [
    marketplaceVerifiedAddon,
    setMarketplaceVerifiedAddon,
  ] =
    useState<
      MarketplaceVerifiedAddonDetails | null
    >(
      null,
    );


  useEffect(
    () => {

      let active =
        true;


      async function loadMarketplaceVerifiedAddon() {

        const studioId =
          studio?.id ??
          null;


        if (!studioId) {

          if (active) {

            setMarketplaceVerifiedAddon(
              null,
            );

          }

          return;

        }


        try {

          const data =
            await getMarketplaceVerifiedAddon(
              studioId,
            );


          if (active) {

            setMarketplaceVerifiedAddon(
              data,
            );

          }

        } catch (
          error
        ) {

          console.error(
            "MARKETPLACE VERIFIED ADDON LOAD ERROR:",
            error,
          );


          if (active) {

            setMarketplaceVerifiedAddon(
              null,
            );

          }

        }

      }


      void loadMarketplaceVerifiedAddon();


      return () => {

        active =
          false;

      };

    },
    [
      studio?.id,
    ],
  );


  const organization =
    bootstrap.data?.workspace.organization ??
    null;


  const studioName =
    studio?.name ??
    null;


  const organizationName =
    organization?.display_name ??
    organization?.legal_name ??
    null;


  return (
    <header className="border-b border-slate-200 bg-white px-8 py-6">

      <div className="flex items-start justify-between">

        <div className="space-y-4">

          <Breadcrumb />

          <PageHeader />

        </div>


        <div className="flex items-center gap-4">

          <GlobalSearch />


          <div className="relative">

            <button
              type="button"
              onClick={() => {

                setNotificationOpen(
                  (current) =>
                    !current,
                );

              }}
              className="relative flex h-11 w-11 items-center justify-center rounded-2xl border border-slate-200 bg-white transition hover:bg-slate-50"
            >

            <Bell size={18} />

            {!notificationLoading &&
              totalUnread > 0 && (

                <span className="absolute -right-1 -top-1 flex h-5 min-w-5 items-center justify-center rounded-full border-2 border-white bg-red-500 px-1 text-[9px] font-bold leading-none text-white">

                  {
                    totalUnread > 99
                      ? "99+"
                      : totalUnread
                  }

                </span>

              )}

            </button>


            <NotificationPanel
              open={
                notificationOpen
              }
              onClose={() => {

                setNotificationOpen(
                  false,
                );

              }}
            />

          </div>


          <button
            type="button"
            onClick={() => {

              window.location.href =
                "/dashboard/plans";

            }}
            className={
              `hidden h-[112px] min-w-[250px] items-start gap-3 overflow-hidden rounded-2xl border bg-white px-4 py-3 text-left shadow-sm transition hover:shadow-md lg:flex ${
                marketplaceVerifiedAddon?.is_active === true
                  ? "border-amber-400 shadow-amber-100/80"
                  : "border-slate-200 shadow-slate-100/70"
              }`
            }
          >

            <div className="flex h-9 w-9 shrink-0 self-center items-center justify-center rounded-lg bg-amber-500/10 text-amber-600">

              {
                subscriptionLoading
                  ? (
                      <Loader2
                        size={16}
                        className="animate-spin"
                      />
                    )
                  : (
                      <Crown
                        size={17}
                      />
                    )
              }

            </div>


            <div className="min-w-0 flex-1 overflow-hidden">

              <div className="flex items-center justify-between">

                <p className="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">

                  Current Plan

                </p>


                {marketplaceVerifiedAddon?.is_active === true && (

                  <span className="rounded-full bg-amber-100 px-2 py-0.5 text-[8px] font-bold uppercase tracking-wide text-amber-700">

                    Verified

                  </span>

                )}

              </div>


              <div className="mt-2 max-h-[70px] space-y-2 overflow-y-auto pr-1">

                <div className="flex items-center justify-between gap-3 rounded-xl border border-slate-100 bg-slate-50/80 px-2.5 py-2">

                  <div className="min-w-0">

                    <p className="truncate text-sm font-bold text-slate-900">

                      {
                        subscriptionLoading
                          ? "Loading..."
                          : subscription?.plan_name ??
                            subscription?.plan ??
                            "No active plan"
                      }

                    </p>


                    {!subscriptionLoading &&
                      subscription?.price !== null &&
                      subscription?.price !== undefined && (

                        <p className="mt-0.5 text-xs text-slate-500">

                          ₹{subscription.price}
                          {" / "}
                          {subscription.billing_cycle ?? "monthly"}

                        </p>

                      )}

                  </div>


                  {!subscriptionLoading &&
                    subscription?.has_access === true && (

                      <span className="shrink-0 rounded-full bg-green-100 px-2 py-0.5 text-[9px] font-bold uppercase tracking-wide text-green-700">

                        Active

                      </span>

                    )}

                </div>


                {marketplaceVerifiedAddon?.is_active === true && (

                  <div className="rounded-xl border border-amber-200 bg-amber-50/60 px-2.5 py-2">

                    <div className="flex items-center justify-between gap-3">

                      <div className="flex min-w-0 items-center gap-2">

                        <div className="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg border border-slate-700 bg-slate-950 text-sm shadow-sm">

                          👍

                        </div>


                        <div className="min-w-0">

                          <p className="truncate text-xs font-bold text-amber-800">

                            Marketplace Verified

                          </p>


                          <p className="mt-0.5 text-[10px] text-amber-700">

                            ₹99 / monthly

                          </p>

                        </div>

                      </div>


                      <span className="shrink-0 rounded-full bg-amber-100 px-2 py-0.5 text-[9px] font-bold uppercase tracking-wide text-amber-700">

                        Active

                      </span>

                    </div>

                  </div>

                )}

              </div>

            </div>

          </button>



          <UserProfile />

        </div>

      </div>

    </header>
  );

}
