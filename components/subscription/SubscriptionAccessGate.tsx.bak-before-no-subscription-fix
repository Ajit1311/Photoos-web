                                                  ? "border-primary bg-primary/5"
                                                  : "border-border hover:bg-muted"
                                              }
                                            `}
                                          >

                                            {provider.label}


                                            {
                                              selected
                                                ? (
                                                  <Check
                                                    className="
                                                      h-4
                                                      w-4
                                                    "
                                                  />
                                                )
                                                : null
                                            }

                                          </button>
                                        );

                                      },
                                    )
                                  }

                                </div>

                              </div>
                            )
                            : null
                        }

                      </div>


                      {/* NET BANKING */}

                      <button
                        type="button"
                        onClick={() => {

                          selectProvider(
                            "net_banking",
                          );

                        }}
                        className={`
                          flex
                          w-full
                          items-center
                          justify-between
                          rounded-xl
                          border
                          px-4
                          py-4
                          text-left
                          transition-colors
                          ${
