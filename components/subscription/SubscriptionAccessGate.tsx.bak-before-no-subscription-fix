                        </div>


                        {
                          selectedProvider === "card"
                            ? (
                              <Check
                                className="
                                  h-5
                                  w-5
                                "
                              />
                            )
                            : null
                        }

                      </button>

                    </div>


                    <div
                      className="
                        border-t
                        border-border
                        px-6
                        py-5
                        sm:px-8
                      "
                    >

                      <button
                        type="button"
                        disabled={
                          !selectedProvider ||
                          processingPayment
                        }
                        onClick={handlePayment}
                        className="
                          inline-flex
                          h-12
                          w-full
                          items-center
                          justify-center
                          rounded-xl
                          bg-primary
                          px-6
                          text-sm
                          font-semibold
                          text-primary-foreground
                          transition-opacity
                          hover:opacity-90
                          disabled:cursor-not-allowed
                          disabled:opacity-40
                        "
                      >

                        {
                          processingPayment
                            ? "Processing Payment..."
                            : `Pay ${formatCurrency(
                                plan.amount,
                              )}`
                        }

                      </button>

                    </div>

                  </div>
                )
                : null
            }


            {/* ================================================
                STEP 4
                PAYMENT SUCCESS
            ================================================= */}

            {
              step === "SUCCESS"
                ? (
                  <div
                    className="
                      px-6
                      py-12
                      sm:px-10
                      sm:py-14
                    "
                  >

                    <div
                      className="
                        flex
                        justify-center
                      "
                    >

                      <div
                        className="
                          flex
                          h-20
                          w-20
                          items-center
                          justify-center
                          rounded-full
                          bg-primary/10
                          text-4xl
                        "
                      >

                        🎉

                      </div>

                    </div>


                    <div
                      className="
                        mt-7
                        text-center
                      "
                    >

                      <h1
                        className="
                          text-2xl
                          font-semibold
                          tracking-tight
                          sm:text-3xl
                        "
                      >

                        Thank You! Payment Successful

                      </h1>


                      <p
                        className="
                          mt-4
                          text-sm
                          leading-7
                          text-muted-foreground
                        "
                      >

                        You can access PhotoOS software now.

                      </p>

                    </div>


                    <div
                      className="
                        mt-9
                      "
                    >

                      <button
                        type="button"
                        onClick={handleDashboard}
                        className="
                          inline-flex
                          h-12
                          w-full
                          items-center
                          justify-center
                          rounded-xl
                          bg-primary
                          px-6
                          text-sm
                          font-semibold
                          text-primary-foreground
                          transition-opacity
                          hover:opacity-90
                        "
                      >

                        Go to Dashboard

                      </button>

                    </div>

                  </div>
                )
                : null
            }


          </div>

        </section>

      </main>

    </div>
  );

}