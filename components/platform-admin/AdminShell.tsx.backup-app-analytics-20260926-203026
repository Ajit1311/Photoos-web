              className={[
                "group flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm transition",
                pathname === "/admin"
                  ? "bg-white text-[#0A3F61] shadow-sm"
                  : "text-slate-300 hover:bg-white/10 hover:text-white",
                collapsed
                  ? "justify-center"
