              ].join(" ")}
            >
              <LayoutDashboard
                className={[
                  "h-[17px] w-[17px] shrink-0",
                  pathname === "/admin"
                    ? "text-[#0A3F61]"
                    : "text-slate-400 group-hover:text-white",
                ].join(" ")}
              />

              {!collapsed ? (
                <span className="flex-1">
                  Dashboard
                </span>
              ) : null}
            </Link>
          </div>

          {/* Main navigation groups */}
          {navSections
            .filter(
              (section) =>
                section.label !== "Overview",
            )
            .map((section) => {
              const isOpen =
                openSections[
                  section.label
                ] ?? false;

              const hasActiveChild =
                section.items.some((item) =>
                  isActivePath(
                    pathname,
                    item.href,
                  ),
                );

              const toggleSection = () => {
                setOpenSections(
                  (current) => ({
                    ...current,
                    [section.label]:
                      !(
                        current[
                          section.label
