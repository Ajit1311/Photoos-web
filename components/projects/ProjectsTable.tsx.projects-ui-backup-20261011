"use client";

import Link from "next/link";

import type { GetProjectsResponse } from "@/types/api/project";

type ProjectsTableProps = {
  projects: GetProjectsResponse["projects"];
};

export default function ProjectsTable({ projects }: ProjectsTableProps) {
  if (projects.length === 0) {
    return (
      <div className="rounded-2xl border border-dashed p-16 text-center">
        <h2 className="text-xl font-semibold">No Projects Found</h2>
        <p className="mt-3 text-slate-500">
          Create your first project to get started.
        </p>
      </div>
    );
  }

  return (
    <div className="overflow-hidden rounded-2xl border bg-white shadow-sm">
      <table className="min-w-full">
        <thead className="bg-slate-50">
          <tr>
            <th className="px-6 py-4 text-left text-sm font-semibold text-slate-600">
              Project
            </th>
            <th className="px-6 py-4 text-left text-sm font-semibold text-slate-600">
              Event Type
            </th>
            <th className="px-6 py-4 text-left text-sm font-semibold text-slate-600">
              Status
            </th>
            <th className="px-6 py-4 text-right text-sm font-semibold text-slate-600">
              Actions
            </th>
          </tr>
        </thead>
        <tbody>
          {projects.map((project) => (
            <tr
              key={project.id}
              className="border-t transition hover:bg-slate-50"
            >
              <td className="px-6 py-5">
                <div>
                  <p className="font-medium text-slate-900">
                    {project.title}
                  </p>
                  <p className="mt-1 text-sm text-slate-500">
                    {project.description ?? "No description"}
                  </p>
                </div>
              </td>

              <td className="px-6 py-5 text-sm text-slate-600">
                {project.event_type ?? "-"}
              </td>

              <td className="px-6 py-5">
                <span className="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium">
                  {project.status}
                </span>
              </td>

              <td className="px-6 py-5">
                <div className="flex justify-end gap-2">
                  <Link
                    href={`/dashboard/projects/${project.id}`}
                    className="rounded-lg border px-3 py-2 text-sm hover:bg-slate-50"
                  >
                    View
                  </Link>

                  <Link
                    href={`/dashboard/projects/${project.id}/edit`}
                    className="rounded-lg bg-[#0A3F61] px-3 py-2 text-sm text-white hover:opacity-90"
                  >
                    Edit
                  </Link>

                  <Link
                    href={`/dashboard/projects/${project.id}/events/new`}
                    className="rounded-lg bg-emerald-600 px-3 py-2 text-sm text-white transition hover:bg-emerald-700"
                  >
                    Create Event
                  </Link>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}