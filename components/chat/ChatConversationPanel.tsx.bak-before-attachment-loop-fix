  async function handleRemoveMember(
    memberId: string | null,
  ) {
    if (
      !isStudioOwner ||
      !memberId ||
      removingMemberId
    ) {
      return;
    }

    try {
      setRemovingMemberId(memberId);
      setMemberActionError(null);

      const {
        error: removeError,
      } = await supabase.rpc(
        "remove_chat_conversation_member",
        {
          p_conversation_id:
            conversation.id,
          p_member_id:
            memberId,
        },
      );

      if (removeError) {
        throw removeError;
      }

      setConversationMembers(
        (current) =>
          current.filter(
            (member) =>
              member.id !== memberId,
          ),
      );

      setMemberRefreshKey(
        (current) =>
          current + 1,
      );
    } catch (caughtError) {
      setMemberActionError(
        caughtError instanceof Error
          ? caughtError.message
          : "Unable to remove member.",
      );
    } finally {
      setRemovingMemberId(null);
    }
  }

  const sortedMessages =
    useMemo(
      () =>
        [...messages].sort(
          (a, b) =>
            new Date(
              a.created_at,
            ).getTime() -
            new Date(
              b.created_at,
            ).getTime(),
        ),
      [messages],
    );

  useEffect(() => {
    if (
      loading ||
      error ||
      !currentUserId ||
      !sortedMessages.length
    ) {
      return;
    }

    const unreadMessages =
      sortedMessages.filter(
        (item) =>
          item.sender_id !==
          currentUserId,
      );

    if (!unreadMessages.length) {
      return;
    }

    void (
      async () => {

        try {

          await Promise.all(
            unreadMessages.map(
              (item) =>
                markChatMessageRead(
                  item.id,
                ),
            ),
          );


          await reloadNotifications();

        } catch (
          markReadError
        ) {

          console.error(
            "CHAT MARK READ ERROR:",
            markReadError,
          );

        }

      }
    )();
  }, [
    currentUserId,
    loading,
    error,
    sortedMessages,
    reloadNotifications,
  ]);

  useEffect(() => {
    let cancelled = false;

    async function loadAttachments() {
      if (
        !sortedMessages.length
      ) {
        setAttachments({});
        return;
      }

      const results =
        await Promise.all(
          sortedMessages.map(
            async (item) => {
              try {
                const data =
                  await getChatMessageAttachments(
                    item.id,
                  );

                return {
                  messageId:
                    item.id,
                  attachments:
                    data,
                };
              } catch {
                return {
                  messageId:
                    item.id,
                  attachments: [],
                };
              }
            },
          ),
        );

      if (cancelled) {
        return;
      }

      const next:
        MessageAttachmentsMap =
        {};

      for (
        const result of results
      ) {
        if (
          result.attachments.length
        ) {
          next[
            result.messageId
          ] =
            result.attachments;
        }
      }

      setAttachments(next);
    }

    void loadAttachments();

    return () => {
      cancelled = true;
    };
