const MAX_FILE_SIZE =
  25 * 1024 * 1024;

function getConversationName(
  conversation: ChatConversation,
) {
  return (
    conversation.title ||
    "Client Conversation"
  );
}

function formatMessageTime(
  value: string,
) {
  const date =
    new Date(value);

  if (
    Number.isNaN(
      date.getTime(),
    )
  ) {
    return "";
  }

  return date.toLocaleTimeString(
    "en-IN",
    {
      hour: "2-digit",
      minute: "2-digit",
    },
  );
}

function getInitials(
  value: string,
) {
  return value
    .split(" ")
    .filter(Boolean)
    .slice(0, 2)
    .map(
      (part) =>
        part[0]?.toUpperCase() ?? "",
    )
    .join("");
}

function formatFileSize(
  size: number | null | undefined,
) {
  if (
    !size ||
    size <= 0
  ) {
    return "";
  }

  if (size < 1024) {
    return `${size} B`;
  }

  if (size < 1024 * 1024) {
    return `${(
      size / 1024
    ).toFixed(1)} KB`;
  }

  if (
    size <
    1024 * 1024 * 1024
  ) {
    return `${(
      size /
      (1024 * 1024)
    ).toFixed(1)} MB`;
  }

  return `${(
    size /
    (1024 * 1024 * 1024)
  ).toFixed(1)} GB`;
}

function isImageFile(
  attachment: ChatMessageAttachment,
) {
  return Boolean(
    attachment.file_type?.startsWith(
      "image/",
    ),
  );
}

function getFileIcon(
  attachment: ChatMessageAttachment,
) {
  const type =
    attachment.file_type ?? "";

  if (
    type.startsWith(
      "image/",
    )
  ) {
    return FileImage;
  }

  if (
    type.includes("pdf") ||
    type.includes("document") ||
    type.includes("text") ||
    type.includes("word")
  ) {
    return FileText;
  }

  if (
    type.includes("zip") ||
    type.includes("rar") ||
    type.includes("archive") ||
    type.includes("compressed")
  ) {
    return FileArchive;
  }

  return File;
}

