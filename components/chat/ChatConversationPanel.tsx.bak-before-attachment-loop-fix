  async function uploadOneFile(
    file: File,
  ) {
    if (file.size <= 0) {
      throw new Error(
        `${file.name} is empty.`,
      );
    }

    if (
      file.size >
      MAX_FILE_SIZE
    ) {
      throw new Error(
        `${file.name} is larger than 25 MB.`,
      );
    }

    const mediaType =
      file.type.startsWith(
        "image/",
      )
        ? "image"
        : "file";

    const messageId =
      await sendChatMessage(
        conversation.id,
        file.name,
        {
          messageType:
            mediaType,
          replyToId:
            replyingTo?.id ?? null,
          metadata: {
            attachment_uploading:
              true,
            file_name:
              file.name,
            file_type:
              file.type || null,
            file_size:
              file.size,
            media_kind:
              file.type.startsWith(
                "video/",
              )
                ? "video"
                : file.type.startsWith(
                      "audio/",
                    )
                  ? "audio"
                  : file.type.startsWith(
                        "image/",
                      )
                    ? "image"
                    : "file",
          },
        },
      );

    const prepared =
      await prepareChatAttachmentUpload(
        conversation.id,
        file,
      );

    /*
     * Always upload as application/octet-stream.
     *
     * This avoids StorageApiError for types such as:
     * audio/mpeg
     *
     * The original MIME type is preserved in
     * attachment metadata and file_type.
     */
    const storageContentType =
      "application/octet-stream";

    const {
      error: uploadError,
    } =
      await supabase.storage
        .from(
          prepared.bucket,
        )
        .upload(
          prepared.storage_path,
          file,
          {
            contentType:
              storageContentType,
            upsert: false,
          },
        );

    if (uploadError) {
      throw uploadError;
    }

    await completeChatAttachmentUpload({
      messageId,
      attachmentId:
        prepared.attachment_id,
      storagePath:
        prepared.storage_path,
      fileName:
        prepared.storage_filename ||
        file.name,
      fileType:
        file.type || null,
      fileSize:
        file.size,
      metadata: {
        original_name:
          file.name,
        mime_type:
          file.type || null,
        storage_content_type:
          storageContentType,
        size:
          file.size,
      },
    });
  }

  async function handleFileChange(
    event: React.ChangeEvent<HTMLInputElement>,
  ) {
    const selectedFiles =
      Array.from(
        event.target.files ?? [],
      );

    event.target.value = "";

    if (
      !selectedFiles.length ||
      sending ||
      uploading
    ) {
      return;
    }

    setAttachmentError(null);
    setUploading(true);
    setUploadProgress(0);

    try {
      for (
        let index = 0;
        index < selectedFiles.length;
        index += 1
      ) {
        const file =
          selectedFiles[index];

        setUploadProgress(
          Math.round(
            (index /
              selectedFiles.length) *
              100,
          ),
        );

        await uploadOneFile(file);

        setUploadProgress(
          Math.round(
            ((index + 1) /
              selectedFiles.length) *
              100,
          ),
        );
      }

      setReplyingTo(null);

      await refresh();

      window.setTimeout(() => {
        setUploadProgress(0);
      }, 500);
    } catch (caughtError) {
      console.error(
        "CHAT ATTACHMENT UPLOAD ERROR:",
        caughtError,
      );

      setAttachmentError(
        caughtError instanceof Error
          ? caughtError.message
          : "Unable to upload attachment.",
      );

      setUploadProgress(0);
    } finally {
      setUploading(false);
    }
  }

