  async function handleDeleteMessage(
    item: ChatMessage,
  ) {
    if (
      !currentUserId ||
      item.sender_id !== currentUserId
    ) {
      setAttachmentError(
        "You can only remove your own messages.",
      );

      setMessageMenuId(null);

      return;
    }

    const confirmed =
      window.confirm(
        "Delete this message?",
      );

    if (!confirmed) {
      return;
    }

    setMessageMenuId(null);

    try {
      await deleteChatMessage(
        item.id,
      );

      setPinnedMessages(
        (current) =>
          current.filter(
            (pin) =>
              pin.message_id !==
              item.id,
          ),
      );

      setAttachments(
        (current) => {
          const next = {
            ...current,
          };

          delete next[item.id];

          return next;
        },
      );

      await refresh();
    } catch (caughtError) {
      setAttachmentError(
        caughtError instanceof Error
          ? caughtError.message
          : "Unable to delete message.",
      );
    }
  }

