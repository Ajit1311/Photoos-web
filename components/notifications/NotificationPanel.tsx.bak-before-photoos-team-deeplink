"use client";

import { useRouter } from "next/navigation";

import {
  CheckCheck,
  Loader2,
  RotateCcw,
  X,
} from "lucide-react";

import {
useNotificationContext,
} from "@/context/NotificationContext";

import { resolveNotificationAction } from "@/lib/notification/resolve-notification-action";


type NotificationPanelProps = {

  open:
    boolean;

  onClose:
    () => void;

};


export default function NotificationPanel({
  open,
  onClose,
}: NotificationPanelProps) {

  const router = useRouter();

  const handleNotificationClick = (
    notification: Parameters<
      typeof resolveNotificationAction
    >[0],
  ) => {
    const destination =
      resolveNotificationAction(
        notification,
      );

    if (destination) {
      router.push(
        destination,
      );
    }
  };

  const {
    center,
    badge,
    loading,
    refreshing,
    error,
    reload,
    markAsRead,
    markAllAsRead,
    chatUnread,
  } =
    useNotificationContext();


  if (
    !open
  ) {

    return null;

  }


  return (

    <div className="absolute right-0 top-full z-50 mt-3 w-[420px] overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl shadow-slate-200/70">

      <div className="flex items-center justify-between border-b border-slate-100 px-5 py-4">

        <div>

          <div className="flex items-center gap-2">

            <h3 className="text-sm font-bold text-slate-900">

              Notifications

            </h3>


            {badge.unread > 0 && (

              <span className="rounded-full bg-red-50 px-2 py-0.5 text-[10px] font-bold text-red-600">

                {badge.unread > 99
                  ? "99+"
                  : badge.unread}

                {" unread"}

              </span>

            )}

          </div>


          <p className="mt-1 text-xs text-slate-400">

            {center.count > 0
              ? `${center.count} notification${center.count === 1 ? "" : "s"}`
              : "You're all caught up"}

          </p>

        </div>


        <div className="flex items-center gap-2">

          {badge.unread > 0 && (

            <button
              type="button"
              onClick={() => {

                void (
                  async () => {

                    try {

                      await markAllAsRead();

                    } catch (
                      error
                    ) {

                      console.error(
                        "NOTIFICATION MARK ALL ERROR:",
                        error,
                      );

                    }

                  }
                )();

              }}
              className="flex h-8 items-center gap-1.5 rounded-lg px-2 text-[10px] font-bold text-blue-600 transition hover:bg-blue-50"
            >

              <CheckCheck
                size={14}
              />

              Mark all read

            </button>

          )}

          <button
            type="button"
            onClick={() => {

              void reload();

            }}
            disabled={refreshing}
            className="flex h-8 w-8 items-center justify-center rounded-lg text-slate-400 transition hover:bg-slate-100 hover:text-slate-700 disabled:cursor-not-allowed"
            title="Refresh notifications"
          >

            {refreshing
              ? (
                  <Loader2
                    size={15}
                    className="animate-spin"
                  />
                )
              : (
                  <RotateCcw
                    size={15}
                  />
                )}

          </button>


          <button
            type="button"
            onClick={onClose}
            className="flex h-8 w-8 items-center justify-center rounded-lg text-slate-400 transition hover:bg-slate-100 hover:text-slate-700"
            title="Close"
          >

            <X
              size={17}
            />

          </button>

        </div>

      </div>


      {chatUnread > 0 && (

        <button
          type="button"
          onClick={() => {

            window.location.href =
              "/dashboard/chat";

          }}
          className="flex w-full items-center justify-between border-b border-blue-100 bg-blue-50/50 px-5 py-4 text-left transition hover:bg-blue-50"
        >

          <div>

            <p className="text-sm font-bold text-blue-900">

              Chat messages

            </p>

            <p className="mt-1 text-xs text-blue-600">

              You have {chatUnread} unread message{chatUnread === 1 ? "" : "s"}

            </p>

          </div>


          <span className="flex min-w-6 items-center justify-center rounded-full bg-blue-600 px-2 py-1 text-[10px] font-bold text-white">

            {chatUnread > 99
              ? "99+"
              : chatUnread}

          </span>

        </button>

      )}


      <div className="max-h-[480px] overflow-y-auto">

        {loading && (

          <div className="flex items-center justify-center py-16">

            <Loader2
              size={22}
              className="animate-spin text-slate-400"
            />

          </div>

        )}


        {!loading &&
          error && (

            <div className="px-5 py-12 text-center">

              <p className="text-sm font-medium text-red-600">

                Failed to load notifications

              </p>


              <button
                type="button"
                onClick={() => {

                  void reload();

                }}
                className="mt-3 text-xs font-bold text-slate-700 underline underline-offset-4"
              >

                Try again

              </button>

            </div>

          )}


        {!loading &&
          !error &&
          center.items.length === 0 && (

            <div className="px-5 py-16 text-center">

              <div className="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-100">

                <CheckCheck
                  size={21}
                  className="text-slate-400"
                />

              </div>


              <p className="mt-4 text-sm font-bold text-slate-700">

                No notifications

              </p>


              <p className="mt-1 text-xs text-slate-400">

                New activity will appear here.

              </p>

            </div>

          )}


        {!loading &&
          !error &&
          center.items.map(
            (
              notification,
            ) => {

              const isUnread =
                !notification.read_at;


              return (

                <button
                  key={notification.id}
                  type="button"

                  onClick={() => {
                    void (
                      async () => {
                        try {
                          if (
                            !notification.read_at
                          ) {
                            await markAsRead(
                              notification.id,
                            );
                          }

                          handleNotificationClick(
                            notification,
                          );

                          onClose();

                        } catch (
                          error
                        ) {
                          console.error(
                            "NOTIFICATION CLICK ERROR:",
                            error,
                          );
                        }
                      }
                    )();
                  }}
                  className={`flex w-full gap-3 border-b border-slate-100 px-5 py-4 text-left transition hover:bg-slate-50 ${
                    isUnread
                      ? "bg-blue-50/30"
                      : "bg-white"
                  }`}
                >

                  <div
                    className={`mt-1 h-2 w-2 shrink-0 rounded-full ${
                      isUnread
                        ? "bg-blue-500"
                        : "bg-transparent"
                    }`}
                  />


                  <div className="min-w-0 flex-1">

                    <div className="flex items-start justify-between gap-3">

                      <p className="truncate text-sm font-bold text-slate-800">

                        {notification.title}

                      </p>


                      {notification.priority >= 8 && (

                        <span className="shrink-0 rounded-full bg-red-50 px-2 py-0.5 text-[9px] font-bold uppercase text-red-600">

                          High

                        </span>

                      )}

                    </div>


                    <p className="mt-1 line-clamp-2 text-xs leading-5 text-slate-500">

                      {notification.body}

                    </p>


                    <p className="mt-2 text-[10px] font-medium text-slate-400">

                      {new Date(
                        notification.created_at,
                      ).toLocaleString()}

                    </p>

                  </div>

                </button>

              );

            },
          )}

      </div>

    </div>

  );

}
